<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS PAL implementation. AppKit interop and the BevelHelper gRPC client
       land here in M1+. M0 ships compile-only stubs + helper lifecycle. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Interface-contract events not yet raised by the M0 stubs. -->
    <NoWarn>$(NoWarn);CS0067</NoWarn>
    <!-- Inbound Apple Event handler IMP is a delegate* unmanaged function pointer (bevel-376). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Favicon lookups against the browsers' own on-disk caches (bevel-l17f) — same raw ADO.NET
         provider the settings store uses. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bevel.Pal.MacOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
    <ProjectReference Include="..\Bevel.Ipc\Bevel.Ipc.csproj" />
  </ItemGroup>

</Project>
