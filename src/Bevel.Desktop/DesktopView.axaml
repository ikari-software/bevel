<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bevel.Desktop.DesktopView"
             Background="#3A6EA5">

    <!-- Desktop: wallpaper fill (Teal blue = Win2000 default) + icon grid placeholder -->
    <Panel>
        <TextBlock Text="Desktop"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="14"
                   Opacity="0.3" />
    </Panel>
</UserControl>