<Project Sdk="Microsoft.NET.Sdk">

  <!-- Taskbar module (window list, start menu, tray, clock). Feature modules reference
       Bevel.UI + Bevel.Core + Bevel.Pal.Abstractions ONLY — never a concrete PAL (ARCH-03). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Native ObjC block interop for the global mouse-down monitor (bevel-ww71, TaskbarNative). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The test project drives WorkAreaMitigator.MitigateOnceAsync (internal) a tick at a
       time, free of the poll loop's timing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Bevel.Taskbar.Tests" />
    <!-- Perf harness benchmarks ComputeButtonLayout / AssignRows (both internal). -->
    <InternalsVisibleTo Include="Bevel.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <!-- Start-button OS badges: Windows flag + Tux ship as SVG assets (avares://Bevel.Taskbar/Assets/…),
       parsed to vector paths by StartLogo; the Apple mark stays self-drawn vector. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.UI\Bevel.UI.csproj" />
    <ProjectReference Include="..\Bevel.Core\Bevel.Core.csproj" />
    <ProjectReference Include="..\Bevel.ComponentBus\Bevel.ComponentBus.csproj" />
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
    <!-- Start menu uses classic:ClassicBorderDecorator (the raised 3D menu border) in XAML. -->
    <ProjectReference Include="..\..\third_party\classic-avalonia\Classic.Avalonia.Theme\Classic.Avalonia.Theme.csproj" />
  </ItemGroup>

</Project>
