<Project Sdk="Microsoft.NET.Sdk">

  <!-- Taskbar module (window list, start menu, tray, clock). Feature modules reference
       Bevel.UI + Bevel.Core + Bevel.Pal.Abstractions ONLY — never a concrete PAL (ARCH-03). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.UI\Bevel.UI.csproj" />
    <ProjectReference Include="..\Bevel.Core\Bevel.Core.csproj" />
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
    <!-- Start menu uses classic:ClassicBorderDecorator (the raised 3D menu border) in XAML. -->
    <ProjectReference Include="..\..\third_party\classic-avalonia\Classic.Avalonia.Theme\Classic.Avalonia.Theme.csproj" />
  </ItemGroup>

</Project>
