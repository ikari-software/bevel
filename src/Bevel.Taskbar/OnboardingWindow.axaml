<ui:BevelWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Bevel.UI"
        x:Class="Bevel.Taskbar.OnboardingWindow"
        Title="Taskbar and Start Menu Properties"
        Width="460" Height="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource Bevel.Brush.ButtonFace}"
        FontFamily="{DynamicResource Bevel.Font.UI}" FontSize="11">
    <!-- Sections are the theme's own group box (HeaderedContentControl → etched frame + header notched into
         the top line, no white card fill), so this dialog uses the Luna components instead of hand-rolled
         Border cards. Body uses the themed face; the caption already names the dialog. -->
    <Grid RowDefinitions="*,Auto" Margin="8">
        <TabControl Grid.Row="0">

            <!-- ── General ──────────────────────────────────────────────── -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">

                    <HeaderedContentControl Header="Accessibility Permission" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="PermStatusDot" Width="15" Height="15" CornerRadius="3"
                                        Background="#9AA0A6" Margin="0,1,0,0" VerticalAlignment="Center">
                                    <!-- Neutral filled dot + dash until the async permission check resolves
                                         (UpdatePermissionUI swaps in the real colour + check/cross/dash). -->
                                    <Path x:Name="PermStatusGlyph" Stroke="White" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round" Data="M0,3 L7,3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="PermStatusText"
                                           Text="Checking..."
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="GrantAccessibilityBtn"
                                    Content="Open Security &#38; Privacy Settings"
                                    FontSize="11" Padding="8,4"
                                    IsVisible="False" />
                            <TextBlock x:Name="PermHint"
                                       Text="Grant Accessibility to enable window management."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Screen Recording Permission" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="ScreenRecStatusDot" Width="15" Height="15" CornerRadius="3"
                                        Background="#9AA0A6" Margin="0,1,0,0" VerticalAlignment="Center">
                                    <Path x:Name="ScreenRecStatusGlyph" Stroke="White" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round" Data="M0,3 L7,3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="ScreenRecStatusText"
                                           Text="Checking..."
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="GrantScreenRecBtn"
                                    Content="Open Screen Recording Settings"
                                    FontSize="11" Padding="8,4"
                                    IsVisible="False" />
                            <TextBlock x:Name="ScreenRecHint"
                                       Text="Grant Screen Recording for live window titles and tray icon mirroring. Takes effect after a relaunch."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Work-Area Strategy" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="How the taskbar handles the macOS Dock."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" />

                            <RadioButton x:Name="WASNudge"
                                         Content="Window Nudging (default)"
                                         FontSize="11" GroupName="WorkArea">
                                <RadioButton.IsChecked>True</RadioButton.IsChecked>
                            </RadioButton>
                            <TextBlock Text="Dock auto-hides; overlapping windows are nudged up."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       Margin="20,0,0,0" />

                            <RadioButton x:Name="WASDockShim"
                                         Content="Dock Shim (strict)"
                                         FontSize="11" GroupName="WorkArea" />
                            <TextBlock x:Name="DockShimNote"
                                       Text="Dock stays visible; taskbar height matches Dock inset. (Measurement required)"
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       Margin="20,0,0,0" />

                            <RadioButton x:Name="WASNone"
                                         Content="None"
                                         FontSize="11" GroupName="WorkArea" />
                            <TextBlock Text="No mitigation; windows may underlap the taskbar."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Startup" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <CheckBox x:Name="RunAtLoginCheck"
                                      Content="Launch Bevel at login"
                                      FontSize="11" />
                            <TextBlock Text="Starts the desktop and taskbar when you log in."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Start (bevel-cust.start) ─────────────────────────────── -->
            <TabItem Header="Start">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="Start Button" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Changes apply immediately." FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" />

                            <CheckBox x:Name="ShowStartCheck"
                                      Content="Show the Start button" FontSize="11" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Caption" FontSize="11" VerticalAlignment="Center" Width="60" />
                                <TextBox x:Name="StartLabelBox" FontSize="11" Width="160" MaxLength="24"
                                         Watermark="(logo only)" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="The button's text next to the logo. Clear it for a logo-only button (Win11-style)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="Start Menu" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Changes apply immediately." FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Programs to show" FontSize="11"
                                           VerticalAlignment="Center" Width="110" />
                                <Slider x:Name="FrequentCountSlider" Minimum="1" Maximum="20"
                                        Width="170" VerticalAlignment="Center" />
                                <TextBlock x:Name="FrequentCountValue" FontSize="11"
                                           VerticalAlignment="Center" Width="72" />
                            </StackPanel>
                            <TextBlock Text="How many programs the left column keeps — your most-used, with newly-installed ones on top."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Buttons ──────────────────────────────────────────────── -->
            <TabItem Header="Buttons">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="Taskbar Buttons" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <CheckBox x:Name="FixedWidthCheck"
                                      Content="Fixed-width buttons"
                                      FontSize="11" />
                            <TextBlock Text="Buttons keep their full width and the strip scrolls when full, instead of shrinking to share the bar."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Minimum width" FontSize="11" VerticalAlignment="Center" />
                                <Slider x:Name="MinWidthSlider" Minimum="24" Maximum="160"
                                        Width="170" VerticalAlignment="Center" />
                                <TextBlock x:Name="MinWidthValue" FontSize="11"
                                           VerticalAlignment="Center" Width="46" />
                            </StackPanel>
                            <TextBlock Text="Shrink-to-fit keeps labels down to this width; below it, buttons collapse to icon-only."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Group windows" FontSize="11" VerticalAlignment="Center" Width="86" />
                                <ComboBox x:Name="GroupingCombo" FontSize="11" Width="160" VerticalAlignment="Center">
                                    <ComboBoxItem>Never</ComboBoxItem>
                                    <ComboBoxItem>When the bar is full</ComboBoxItem>
                                    <ComboBoxItem>Always</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Collapse an app's windows into one button with a pop-up list (XP/Win7-style)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Labels" FontSize="11" VerticalAlignment="Center" Width="86" />
                                <ComboBox x:Name="LabelModeCombo" FontSize="11" Width="160" VerticalAlignment="Center">
                                    <ComboBoxItem>Auto (hide when crowded)</ComboBoxItem>
                                    <ComboBoxItem>Always show</ComboBoxItem>
                                    <ComboBoxItem>Icon only</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Whether window buttons show their title, or just the icon (Dock/KDE-style)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Sort buttons" FontSize="11" VerticalAlignment="Center" Width="86" />
                                <ComboBox x:Name="SortModeCombo" FontSize="11" Width="160" VerticalAlignment="Center">
                                    <ComboBoxItem>Open order (classic)</ComboBoxItem>
                                    <ComboBoxItem>By app name (A–Z)</ComboBoxItem>
                                    <ComboBoxItem>By icon colour 🌈</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="How buttons are ordered. Open order keeps a button where it opened; by-name sorts A–Z."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <CheckBox x:Name="WindowlessLastCheck"
                                      Content="Show windowless apps (dock-dots) last"
                                      FontSize="11" Margin="0,4,0,0" />

                            <CheckBox x:Name="MiddleClickCloseCheck"
                                      Content="Middle-click a button to close its window"
                                      FontSize="11" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Button size" FontSize="11" VerticalAlignment="Center" />
                                <ComboBox x:Name="ButtonSizeCombo" FontSize="11" Width="120" VerticalAlignment="Center">
                                    <ComboBoxItem>Small</ComboBoxItem>
                                    <ComboBoxItem>Normal</ComboBoxItem>
                                    <ComboBoxItem>Large</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Taller or shorter taskbar buttons — applies immediately."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Rows" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <Slider x:Name="RowsSlider" Minimum="1" Maximum="4"
                                        Width="150" VerticalAlignment="Center" />
                                <TextBlock x:Name="RowsValue" FontSize="11" VerticalAlignment="Center" Width="56" />
                            </StackPanel>
                            <TextBlock Text="How many rows of buttons the bar grows to (also draggable from the taskbar's top edge)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Clock (bevel-cust.clock) ─────────────────────────────── -->
            <TabItem Header="Clock">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="Clock" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Changes apply to the taskbar clock immediately."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" TextWrapping="Wrap" />

                            <CheckBox x:Name="ShowClockCheck"
                                      Content="Show the clock" FontSize="11" Margin="0,4,0,0" />

                            <CheckBox x:Name="Clock24Check"
                                      Content="Use 24-hour time (14:30 vs 2:30 PM)" FontSize="11" />

                            <CheckBox x:Name="ClockSecondsCheck"
                                      Content="Show seconds" FontSize="11" />
                            <TextBlock Text="Ticks every second while on (otherwise once a minute)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <CheckBox x:Name="ClockDateCheck"
                                      Content="Show the date beside the time" FontSize="11" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Appearance (bevel-cust.appearance) ───────────────────── -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="Appearance" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Changes apply immediately." FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Theme" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <ComboBox x:Name="ThemeCombo" FontSize="11" Width="160" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="The visual style engine (chrome geometry, bevels, metrics). The colour scheme and font below layer on top."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" TextWrapping="Wrap" Margin="20,0,0,0" />

                            <!-- Theme-specific appearance options: each theme contributes its own via
                                 ThemeVariants (Win2000 = colour scheme; Luna = colour + gloss). Rebuilt in
                                 code-behind whenever the theme changes, so this panel always reflects the
                                 active theme's capabilities. -->
                            <StackPanel x:Name="ThemeOptionsPanel" Spacing="6" Margin="0,4,0,0" />

                            <CheckBox x:Name="CrispBevelsCheck"
                                      Content="Crisp (pixel-snapped) bevels" FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="Sharpen the theme's 3D edges by snapping them to whole pixels (remembered per theme)."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Font size" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <Slider x:Name="FontSizeSlider" Minimum="9" Maximum="16"
                                        Width="150" VerticalAlignment="Center" />
                                <TextBlock x:Name="FontSizeValue" FontSize="11" VerticalAlignment="Center" Width="42" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Font" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <ComboBox x:Name="FontFamilyCombo" FontSize="11" Width="200" VerticalAlignment="Center"
                                          MaxDropDownHeight="260" />
                            </StackPanel>
                            <TextBlock Text="The UI font. '(Theme default)' uses the theme's bundled face."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Opacity" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100"
                                        Width="150" VerticalAlignment="Center" />
                                <TextBlock x:Name="OpacityValue" FontSize="11" VerticalAlignment="Center" Width="42" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Tint" FontSize="11" VerticalAlignment="Center" Width="84" />
                                <TextBox x:Name="BgColorBox" FontSize="11" Width="150"
                                         Watermark="(theme default)" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="A hex colour like #2A3F5F for the bar background. Clear it to use the theme colour."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tray (bevel-cust.tray) ───────────────────────────────── -->
            <TabItem Header="Tray">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="System Tray" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="The mirrored macOS menu-bar icons. Changes apply immediately."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Show up to" FontSize="11" VerticalAlignment="Center" Width="66" />
                                <Slider x:Name="TrayCapSlider" Minimum="1" Maximum="20"
                                        Width="150" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrayCapValue" FontSize="11" VerticalAlignment="Center" Width="56" />
                            </StackPanel>
                            <TextBlock Text="Icons per taskbar ROW shown inline before the rest move under the overflow chevron — a 2-row bar shows twice as many."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                <TextBlock Text="Icon size" FontSize="11" VerticalAlignment="Center" Width="66" />
                                <Slider x:Name="TrayIconSizeSlider" Minimum="12" Maximum="32"
                                        Width="150" VerticalAlignment="Center" />
                                <TextBlock x:Name="TrayIconSizeValue" FontSize="11" VerticalAlignment="Center" Width="56" />
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Behavior (bevel-cust.behavior) ───────────────────────── -->
            <TabItem Header="Behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="2,8,2,2">
                    <HeaderedContentControl Header="Behavior" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Changes apply immediately." FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}" />

                            <CheckBox x:Name="LockCheck"
                                      Content="Lock the taskbar (disable resizing)"
                                      FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="Hides the row-resize gripper so the taskbar height can't be dragged."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      Content="Keep on top of other windows"
                                      FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="Off drops the taskbar to the normal window level, so windows can cover it."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />

                            <CheckBox x:Name="ShowDesktopCheck"
                                      Content="Show a &quot;Show desktop&quot; button (far right)"
                                      FontSize="11" Margin="0,4,0,0" />
                            <TextBlock Text="A Win7-style sliver at the end of the bar that minimizes every window."
                                       FontSize="10" Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- OK / Cancel / Apply (XP property-sheet convention). OK keeps the live changes; Cancel reverts
             everything to the state when the dialog opened; Apply re-baselines (greyed until next change). -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="6" Margin="0,10,0,0">
            <Button x:Name="OkBtn" Content="OK" Width="75" />
            <Button x:Name="CancelBtn" Content="Cancel" Width="75" />
            <Button x:Name="ApplyBtn" Content="Apply" Width="75" IsEnabled="False" />
        </StackPanel>
    </Grid>
</ui:BevelWindow>
