<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:Bevel.Taskbar"
             xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
             x:Class="Bevel.Taskbar.TaskbarView"
             x:DataType="tb:TaskbarViewModel"
             ClipToBounds="False">
    <Panel>
    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*,Auto"
          ClipToBounds="False"
          Background="{DynamicResource SystemButtonFaceBrush}">

        <!-- Start button: full bar height (no dead space above it in multi-row mode), but capped
             to ~3 button rows in code so a very tall bar keeps a sane Start button. -->
        <Button x:Name="StartButton" Grid.Column="0"
                Width="74" Margin="1,1,0,1"
                FontWeight="Bold" FontSize="11"
                Focusable="False"
                Padding="6,0"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                <!-- OS badge injected in code (StartLogo): Windows flag / Apple / Tux by host OS. -->
                <ContentControl x:Name="StartLogoHost"
                                Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="Start" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Divider after Start (full height) -->
        <Border Grid.Column="0" Width="2" Margin="76,1,0,1"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SystemButtonHighlightBrush}"
                BorderBrush="{DynamicResource SystemButtonShadowBrush}"
                BorderThickness="0,0,1,0" />

        <!-- Window button area: data-bound to the background model's Windows collection (bevel-d2z).
             HorizontalScrollBarVisibility=Disabled constrains the width so the WrapPanel wraps into
             rows as the bar grows taller. Each button's Width/Opacity are animated (XP-style: grow
             from 0 on open, shrink to 0 on close, smooth resize as the strip fills) via the
             template transitions; the code-behind layout pass pushes the shared target width. -->
        <!-- Column 1: the button strip plus an overflow chevron column (bevel-m2.10.2). The strip
             wraps into rows (width-constrained); when the rows exceed the bar height the up/down
             chevrons appear to scroll them. VerticalScrollBarVisibility=Hidden keeps the native
             scrollbar out — the chevrons are the affordance — while still allowing the offset to move. -->
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
        <ScrollViewer x:Name="WindowButtonScroller" Grid.Column="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      VerticalAlignment="Stretch"
                      Margin="2,1,0,1">
            <ItemsControl x:Name="WindowButtonArea" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- The strip holds a mix of single-window buttons and (when grouping is on) app
                     groups; Avalonia selects the template by the item's runtime type (bevel-m2.10.3).
                     With grouping off, Items is the window VMs 1:1, so this is unchanged behaviour. -->
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="tb:TaskItemViewModel">
                        <!-- A checked classic ToggleButton renders with the authentic sunken/
                             hatched active-task state. Binding is one-way: native window state,
                             not the click gesture itself, remains authoritative. -->
                        <ToggleButton Command="{Binding ActivateCommand}"
                                      IsChecked="{Binding IsFocused, Mode=OneWay}"
                                      Focusable="False"
                                      Width="{Binding Width}"
                                      Opacity="{Binding Opacity}"
                                      FontWeight="{Binding TitleWeight}"
                                      MinWidth="0"
                                      Height="24" Margin="1,2" Padding="4,0" FontSize="11"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      ClipToBounds="True">
                            <ToggleButton.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </ToggleButton.Transitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{Binding ContentAlignment}"
                                        ClipToBounds="True" Opacity="{Binding ContentOpacity}"
                                        IsHitTestVisible="False">
                                <Image Source="{Binding IconSource}" Width="16" Height="16"
                                       Margin="{Binding IconMargin}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>

                    <!-- Grouped app: one button showing icon + "Name (N)", opening a flyout that lists
                         the app's windows. IsChecked reflects whether any child window is focused. -->
                    <DataTemplate DataType="tb:TaskGroupViewModel">
                        <ToggleButton IsChecked="{Binding IsFocused, Mode=OneWay}"
                                      Focusable="False"
                                      Width="{Binding Width}"
                                      Opacity="{Binding Opacity}"
                                      MinWidth="0"
                                      Height="24" Margin="1,2" Padding="4,0" FontSize="11"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      ClipToBounds="True">
                            <ToggleButton.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </ToggleButton.Transitions>
                            <ToggleButton.Flyout>
                                <Flyout Placement="Top">
                                    <ItemsControl ItemsSource="{Binding Windows}" MinWidth="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tb:TaskItemViewModel">
                                                <Button Command="{Binding ActivateCommand}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,3" Background="Transparent" BorderThickness="0"
                                                        FontWeight="{Binding TitleWeight}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Image Source="{Binding IconSource}" Width="16" Height="16"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </ToggleButton.Flyout>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{Binding ContentAlignment}"
                                        ClipToBounds="True" IsHitTestVisible="False">
                                <Image Source="{Binding IconSource}" Width="16" Height="16"
                                       Margin="{Binding IconMargin}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Overflow chevrons: scroll the wrapped button rows a row at a time. Hidden until the rows
             overflow the bar height (toggled in code). RepeatButtons so press-and-hold keeps scrolling. -->
        <StackPanel x:Name="OverflowChevrons" Grid.Column="1" Orientation="Vertical"
                    Width="16" Margin="1,1,2,1" IsVisible="False">
            <RepeatButton x:Name="ScrollUpBtn" Content="▲" FontSize="7" Padding="0"
                          Height="13" Focusable="False"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            <RepeatButton x:Name="ScrollDownBtn" Content="▼" FontSize="7" Padding="0"
                          Height="13" Focusable="False" Margin="0,1,0,0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </StackPanel>
        </Grid>

        <!-- Divider before system tray area (full height) -->
        <Border Grid.Column="2" Width="2" Margin="2,1,0,1"
                VerticalAlignment="Stretch"
                Background="{DynamicResource SystemButtonHighlightBrush}"
                BorderBrush="{DynamicResource SystemButtonShadowBrush}"
                BorderThickness="0,0,1,0" />

        <!-- System tray + clock area: full bar height (no dead space above it). Win2000 recesses
             the notification area into a sunken well; ClassicBorderDecorator draws the inset bevel
             and the clock centres within the taller well. -->
        <StackPanel x:Name="TrayArea" Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    Margin="0,1,2,1">
            <classic:ClassicBorderDecorator BorderStyle="Sunken" BorderThickness="2"
                                            Padding="4,0"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource SystemButtonFaceBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <!-- Mirrored menu-bar status items (bevel-m3.1): 16px icons, hover tooltip = AX
                         title. Empty in the split taskbar until the shell-core tray bridge lands. -->
                    <ItemsControl ItemsSource="{Binding Tray.Items}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tb:TrayItemViewModel">
                                <Image Source="{Binding IconSource}" Width="16" Height="16"
                                       VerticalAlignment="Center" ToolTip.Tip="{Binding Tooltip}"
                                       PointerPressed="OnTrayIconPressed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Disconnected indicator: a notification-area icon shown only while the taskbar
                         has lost its link to the shell core. It reconnects automatically (backoff),
                         and this clears itself when the link returns. -->
                    <Grid x:Name="DisconnectedIndicator" Width="14" Height="14"
                          IsVisible="{Binding IsDisconnected}"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Disconnected from the shell core — reconnecting…">
                        <Ellipse Fill="#C0392B" Stroke="#7B241C" StrokeThickness="0.5" />
                        <Rectangle Width="9" Height="2.2" RadiusX="1" RadiusY="1" Fill="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <tb:ClockWidget x:Name="Clock" VerticalAlignment="Center" />
                </StackPanel>
            </classic:ClassicBorderDecorator>
        </StackPanel>

        <!-- Resize grip: dragging the top edge grows/shrinks the bar in whole button-row steps.
             Transparent (not null) so it's hit-testable; spans the full width. -->
        <Border x:Name="ResizeGrip" Grid.Column="0" Grid.ColumnSpan="3"
                Height="4" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNorthSouth" />
    </Grid>

        <!-- Win2000 tooltips above task buttons. A Popup (not ToolTip.Tip) positions in screen
             space above the bar; helper isBevelTransient() filters the small parent-PID surface. -->
        <Popup x:Name="TooltipPopup"
               IsLightDismissEnabled="False"
               Placement="Top"
               VerticalOffset="-2"
               WindowManagerAddShadowHint="False">
            <Border Background="#FFFFE1"
                    BorderBrush="{DynamicResource Bevel.Brush.WindowFrame}"
                    BorderThickness="1" Padding="4,2" MaxWidth="420">
                <TextBlock x:Name="TaskbarTooltipText"
                           Foreground="#000000"
                           FontSize="11" TextWrapping="Wrap" />
            </Border>
        </Popup>
    </Panel>
</UserControl>
