<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:Bevel.Taskbar"
             xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
             x:Class="Bevel.Taskbar.TaskbarView"
             x:DataType="tb:TaskbarViewModel"
             ClipToBounds="False">
    <UserControl.Resources>
        <!-- One explicit dictionary so the merged include and the plain metric entry can coexist
             (Avalonia only allows MergedDictionaries inside an explicit ResourceDictionary).
             ApplyTaskIconMetric still assigns through Resources[...] and lands here unchanged. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The unread/attention pill on a task button (bevel-ijln) — theme-tokened, code-drawn. -->
                <ResourceInclude Source="avares://Bevel.Taskbar/TaskBadge.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Task-button glyph edge in logical px (bevel-c54t). Declared here as the Normal-tier default
                 and REPLACED at runtime from TaskbarTheme.TaskIconSize (see ApplyTaskIconMetric) whenever
                 the Small/Normal/Large/Big tier changes — a DynamicResource so the live settings poll
                 re-sizes already-realized buttons without rebuilding them. Anything that must sit relative
                 to the task icon (e.g. the badge above) should read THIS token, never a hardcoded 16. -->
            <x:Double x:Key="Bevel.Metric.TaskbarIconSize">16</x:Double>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Win2000 selection highlight for the stack-flyout rows (bevel-cust). The DEFAULT background
             must come from a style, not a local Background="Transparent" on the Border: a local value
             outranks a style setter, so a local default would silently veto the :pointerover setter
             (the exact bug behind "white text but no blue"). Transparent (not null) keeps it hit-testable. -->
        <Style Selector="Border.flyoutrow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.flyoutrow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Bevel.Brush.Highlight}" />
        </Style>
        <Style Selector="Border.flyoutrow:pointerover TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Keyboard focus must be visible (WCAG 2.4.7): a focused row gets the same blue selection as
             hover, so tabbing/arrowing through a group or stack flyout is never invisible (bevel-vk4n). -->
        <Style Selector="Border.flyoutrow:focus-visible">
            <Setter Property="Background" Value="{DynamicResource Bevel.Brush.Highlight}" />
        </Style>
        <Style Selector="Border.flyoutrow:focus-visible TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Row-overflow scroll chevrons (multi-row bar): flat vector arrows, no raised Classic button
             chrome, so they read cleanly on the themed bar. The arrow colour is the theme's tray text
             (dark on the Win2000 grey, light on the Luna blue); a subtle wash appears on hover. -->
        <Style Selector="RepeatButton.chevron">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="chev" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RepeatButton.chevron:pointerover /template/ Border#chev">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>
        <Style Selector="RepeatButton.chevron:pressed /template/ Border#chev">
            <Setter Property="Background" Value="#22000000" />
        </Style>
        <!-- Visible keyboard focus for the overflow chevrons (WCAG 2.4.7, bevel-vk4n). -->
        <Style Selector="RepeatButton.chevron:focus-visible /template/ Border#chev">
            <Setter Property="Background" Value="#55FFFFFF" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*,Auto"
          ClipToBounds="False"
          Background="Transparent">
        <!-- Right-click the empty taskbar (bevel-cust.ctxmenu). Cascade/Tile join in the superset pass. -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="Show the _Desktop" Command="{Binding ShowDesktopCommand}" />
                <MenuItem Header="_Task Manager…" Click="OnTaskManagerClick" />
                <Separator />
                <MenuItem x:Name="LockMenuItem" Header="_Lock the Taskbar" Click="OnLockTaskbarClick" />
                <MenuItem Header="P_roperties…" Click="OnPropertiesClick" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- The themed taskbar fill, as its OWN layer behind every button (bevel-cust.appearance).
             Opacity is the fill's ALPHA: scaling this layer's opacity keeps the theme's real fill —
             Luna's purple GRADIENT, Win2000's grey — as RGBA and lets the desktop show through it,
             instead of flattening to the button-face colour. IsHitTestVisible=False so right-click on
             the empty bar still hits RootGrid's context menu. -->
        <Border x:Name="TaskbarBg" Grid.Column="0" Grid.ColumnSpan="3"
                IsHitTestVisible="False"
                Background="{DynamicResource Bevel.Brush.TaskbarBackground}" />

        <!-- The bar's top edge: a single theme-tokened highlight line (NOT a 4-sided win2k window frame),
             kept at full opacity so it still defines the bar when the fill is translucent. -->
        <Border Grid.Column="0" Grid.ColumnSpan="3"
                VerticalAlignment="Top" Height="1" IsHitTestVisible="False"
                Background="{DynamicResource Bevel.Brush.TaskbarDividerLight}" />

        <!-- Start button: full bar height (no dead space above it in multi-row mode), but capped
             to ~3 button rows in code so a very tall bar keeps a sane Start button. -->
        <Button x:Name="StartButton" Grid.Column="0"
                Width="74" Margin="{DynamicResource Bevel.Metric.StartButtonMargin}"
                Theme="{DynamicResource Bevel.Theme.StartButton}"
                Focusable="True"
                AutomationProperties.Name="Start"
                Padding="6,0"
                ClipToBounds="True"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Stretch">
            <Button.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="P_roperties…" Click="OnPropertiesClick" />
                </MenuFlyout>
            </Button.ContextFlyout>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                <!-- Badge injected in code (StartLogo): the Bevel mark, or Tux on Linux. It sizes itself from
                     Bevel.Metric.StartBadgeSize, so no fixed Width/Height here. -->
                <ContentControl x:Name="StartLogoHost" VerticalAlignment="Center" />
                <TextBlock x:Name="StartLabelText" Text="Start" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Divider after Start (full height) -->
        <Border Grid.Column="0" Width="2" Margin="76,1,0,1"
                VerticalAlignment="Stretch"
                Background="{DynamicResource Bevel.Brush.TaskbarDividerLight}"
                BorderBrush="{DynamicResource Bevel.Brush.TaskbarDividerDark}"
                BorderThickness="0,0,1,0" />

        <!-- Window button area: data-bound to the background model's Windows collection (bevel-d2z).
             HorizontalScrollBarVisibility=Disabled constrains the width so the WrapPanel wraps into
             rows as the bar grows taller. Each button's Width/Opacity are animated (XP-style: grow
             from 0 on open, shrink to 0 on close, smooth resize as the strip fills) via the
             template transitions; the code-behind layout pass pushes the shared target width. -->
        <!-- Column 1: the button strip plus an overflow chevron column (bevel-m2.10.2). The strip
             wraps into rows (width-constrained); when the rows exceed the bar height the up/down
             chevrons appear to scroll them. VerticalScrollBarVisibility=Hidden keeps the native
             scrollbar out — the chevrons are the affordance — while still allowing the offset to move. -->
        <Grid Grid.Column="1">
        <ScrollViewer x:Name="WindowButtonScroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      VerticalAlignment="Stretch"
                      Margin="2,1,0,1">
            <ItemsControl x:Name="WindowButtonArea" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- The strip holds a mix of single-window buttons and (when grouping is on) app
                     groups; Avalonia selects the template by the item's runtime type (bevel-m2.10.3).
                     With grouping off, Items is the window VMs 1:1, so this is unchanged behaviour. -->
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="tb:TaskItemViewModel">
                        <!-- A checked classic button renders with the authentic sunken/hatched active-
                             task state. TaskButton never self-toggles: IsChecked is a OneWay projection
                             of the shell's focus (bevel-zk4a), so the click can't diverge from it. -->
                        <tb:TaskButton Command="{Binding ActivateCommand}"
                                      IsChecked="{Binding IsFocused, Mode=OneWay}"
                                      Focusable="True"
                                      AutomationProperties.Name="{Binding Title}"
                                      Width="{Binding Width}"
                                      Opacity="{Binding Opacity}"
                                      FontWeight="{Binding TitleWeight}"
                                      MinWidth="0"
                                      Height="24" Margin="1,2,0,2" Padding="4,0" FontSize="11"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      ClipToBounds="True"
                                      ContextRequested="OnTaskButtonContextRequested">
                            <tb:TaskButton.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </tb:TaskButton.Transitions>
                            <!-- App-centric right-click menu (bevel-ww71): app header, Windows submenu (per-
                                 window Activate/Minimize/Close), Quit (Alt → Force Quit). Built in code —
                                 see TaskButtonMenu / OnTaskButtonContextRequested. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{Binding ContentAlignment}"
                                        ClipToBounds="True" Opacity="{Binding ContentOpacity}"
                                        IsHitTestVisible="False">
                                <!-- Glyph edge is the tier token, not a hardcoded 16 (bevel-c54t): Large/Big
                                     grow it to 24/32 from the helper's 64px source PNG (downscale, never
                                     an upscaled 16px bitmap), HighQuality so it stays smooth. -->
                                <Image Source="{Binding IconSource}" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Width="{DynamicResource Bevel.Metric.TaskbarIconSize}"
                                       Height="{DynamicResource Bevel.Metric.TaskbarIconSize}"
                                       Margin="{Binding IconMargin}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                                <!-- Unread count BEFORE the title (bevel-ijln): stays put in the icon-only
                                     tier, where the label collapses but the badge must not. -->
                                <ContentControl Theme="{DynamicResource Bevel.Theme.TaskBadge}"
                                                Content="{Binding BadgeText}"
                                                IsVisible="{Binding HasBadge}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowLabel}"
                                           FontStyle="{Binding TitleStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </tb:TaskButton>
                    </DataTemplate>

                    <!-- Grouped app: one button showing icon + "Name (N)", opening a flyout that lists
                         the app's windows. IsChecked reflects whether any child window is focused. -->
                    <DataTemplate DataType="tb:TaskGroupViewModel">
                        <tb:TaskButton IsChecked="{Binding IsFocused, Mode=OneWay}"
                                      Focusable="True"
                                      AutomationProperties.Name="{Binding Label}"
                                      Width="{Binding Width}"
                                      Opacity="{Binding Opacity}"
                                      MinWidth="0"
                                      Height="24" Margin="1,2,0,2" Padding="4,0" FontSize="11"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      ClipToBounds="True"
                                      ContextRequested="OnTaskButtonContextRequested">
                            <tb:TaskButton.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                                </Transitions>
                            </tb:TaskButton.Transitions>
                            <!-- App-centric right-click menu (bevel-ww71): app header, Windows submenu (per-
                                 window Activate/Minimize/Close), Quit (Alt → Force Quit). Built in code. -->
                            <tb:TaskButton.Flyout>
                                <Flyout Placement="Top">
                                    <ItemsControl ItemsSource="{Binding Windows}" MinWidth="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tb:TaskItemViewModel">
                                                <Border Classes="flyoutrow" HorizontalAlignment="Stretch"
                                                        Padding="6,3" Tapped="OnGroupWindowTapped"
                                                        Focusable="True" KeyDown="OnGroupWindowKeyDown"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Image Source="{Binding IconSource}" RenderOptions.BitmapInterpolationMode="HighQuality" Width="16" Height="16"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                                   FontWeight="{Binding TitleWeight}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </tb:TaskButton.Flyout>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{Binding ContentAlignment}"
                                        ClipToBounds="True" IsHitTestVisible="False">
                                <!-- Glyph edge is the tier token, not a hardcoded 16 (bevel-c54t): Large/Big
                                     grow it to 24/32 from the helper's 64px source PNG (downscale, never
                                     an upscaled 16px bitmap), HighQuality so it stays smooth. -->
                                <Image Source="{Binding IconSource}" RenderOptions.BitmapInterpolationMode="HighQuality"
                                       Width="{DynamicResource Bevel.Metric.TaskbarIconSize}"
                                       Height="{DynamicResource Bevel.Metric.TaskbarIconSize}"
                                       Margin="{Binding IconMargin}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                                <!-- The APP's unread count (bevel-ijln). Distinct from the "(N)" window
                                     count in Label, which is the glomming count (R-TB-6). -->
                                <ContentControl Theme="{DynamicResource Bevel.Theme.TaskBadge}"
                                                Content="{Binding BadgeText}"
                                                IsVisible="{Binding HasBadge}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           IsVisible="{Binding ShowLabel}"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </tb:TaskButton>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <!-- Overflow chevrons: scroll the wrapped button rows a row at a time. Hidden until the rows
             overflow the bar height (toggled in code). OVERLAID on the scroller's right edge (same
             cell, not a width-stealing column) so showing/hiding them never changes the scroller's
             width — that width-feedback caused a 1-row⇄2-row flip-flop (bevel-m2.10.2 regression).
             Solid background so the arrows occlude the button underneath cleanly. -->
        <StackPanel x:Name="OverflowChevrons" Orientation="Vertical"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="{DynamicResource Bevel.Brush.TrayWell}"
                    Width="16" Margin="1,1,2,1" IsVisible="False">
            <RepeatButton x:Name="ScrollUpBtn" Classes="chevron" Height="14" Focusable="True"
                          AutomationProperties.Name="Scroll buttons up">
                <Path Data="M0,4 L4,0 L8,4 Z" Fill="{DynamicResource Bevel.Brush.TrayText}" />
            </RepeatButton>
            <RepeatButton x:Name="ScrollDownBtn" Classes="chevron" Height="14" Focusable="True" Margin="0,1,0,0"
                          AutomationProperties.Name="Scroll buttons down">
                <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource Bevel.Brush.TrayText}" />
            </RepeatButton>
        </StackPanel>
        </Grid>

        <!-- Divider before system tray area (full height) -->
        <Border Grid.Column="2" Width="2" Margin="2,1,0,1"
                VerticalAlignment="Stretch"
                Background="{DynamicResource Bevel.Brush.TaskbarDividerLight}"
                BorderBrush="{DynamicResource Bevel.Brush.TaskbarDividerDark}"
                BorderThickness="0,0,1,0" />

        <!-- System tray + clock area: full bar height (no dead space above it). Win2000 recesses
             the notification area into a sunken well; ClassicBorderDecorator draws the inset bevel
             and the clock centres within the taller well. -->
        <StackPanel x:Name="TrayArea" Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    Margin="0,1,2,1">
            <!-- Folder stacks (bevel-12g): tray-adjacent buttons LEFT of the notification well (not
                 inside it) — a folder whose flyout shows recent contents as a preview grid (bevel-9elh).
                 A blue dot cues new items. Click refreshes + opens the flyout; each cell opens its file. -->
            <ItemsControl ItemsSource="{Binding Stacks.Stacks}" VerticalAlignment="Center" Margin="0,0,4,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tb:StackViewModel">
                                <Button Padding="1" Background="Transparent" BorderThickness="0"
                                        Focusable="True" ToolTip.Tip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Click="OnStackButtonClick">
                                    <Grid Width="16" Height="16">
                                        <Image Source="{Binding FolderIcon}" Width="16" Height="16" />
                                        <!-- New-item cue: a coloured dot for sighted users, with a text alternative
                                             (AutomationProperties.Name + tooltip) so AT announces "New items" too. -->
                                        <Ellipse Width="6" Height="6" Fill="#2E86D8" Stroke="White" StrokeThickness="1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 ToolTip.Tip="New items"
                                                 AutomationProperties.Name="New items"
                                                 IsVisible="{Binding HasNew}" />
                                    </Grid>
                                    <Button.Flyout>
                                        <!-- The flyout's whole content lives in StackFlyoutView (bevel-9elh):
                                             a macOS-style grid of content previews + the "Open folder" row. -->
                                        <Flyout Placement="Top">
                                            <tb:StackFlyoutView />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

            <classic:ClassicBorderDecorator BorderStyle="Sunken"
                                            BorderThickness="{DynamicResource Bevel.Metric.TrayWellBorder}"
                                            VerticalAlignment="Stretch"
                                            Background="{DynamicResource Bevel.Brush.TrayWell}">
              <!-- Inner fill paints OVER the Classic decorator's grey face: grey-on-grey in Win2000
                   (seamless, keeps the sunken bevel), blue-on-grey in Luna (covers it; bevel off). -->
              <Border Background="{DynamicResource Bevel.Brush.TrayWell}" Padding="4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <!-- Mirrored menu-bar status items (bevel-m3.1). No dark backing chip anymore: template
                         glyphs are recoloured to the bar's contrast ink (TrayIconTint, macOS model) so they
                         read directly on the tray; colourful/self-contained icons keep their own look.
                         First N inline; the rest behind the » chevron (bevel-m3.4). Hidden when empty. -->
                    <Border Background="Transparent" Padding="3,0" VerticalAlignment="Center"
                            IsVisible="{Binding Tray.HasAnyItems}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Overflow chevron on the LEFT (Windows "show hidden icons"): an up glyph
                                 since the flyout opens above the bar; lists the hidden icons (dark backed). -->
                            <Button x:Name="TrayOverflowButton" IsVisible="{Binding Tray.HasOverflow}" Focusable="True"
                                    AutomationProperties.Name="Show hidden icons"
                                    Padding="3,0" Background="Transparent" BorderThickness="0"
                                    FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Bevel.Brush.TrayText}"
                                    Content="&#x2303;" ToolTip.Tip="Show hidden icons" VerticalAlignment="Center">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <!-- Overflow popup matches the bar's tray well so the same contrast
                                             ink reads here too. -->
                                        <Border Background="{DynamicResource Bevel.Brush.TrayWell}" Padding="4" CornerRadius="3"
                                                BorderBrush="{DynamicResource Bevel.Brush.TaskbarDividerDark}" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding Tray.OverflowItems}" MaxWidth="220">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="tb:TrayItemViewModel">
                                                        <!-- Icon-or-placeholder cell (bevel-yduf) — one definition,
                                                             shared with the inline strip below. -->
                                                        <tb:TrayIconCell Margin="4"
                                                                         PointerPressed="OnTrayIconPressed"
                                                                         KeyDown="OnTrayIconKeyDown" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <ItemsControl ItemsSource="{Binding Tray.VisibleItems}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Rows = the taskbar row count (bevel-m3). TrayRowsPanel packs
                                             icons into exactly that many rows at their NATURAL widths
                                             (a wide status item takes proportional room), unlike a
                                             UniformGrid which would size every cell to the widest icon. -->
                                        <tb:TrayRowsPanel Rows="{Binding Tray.Rows}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tb:TrayItemViewModel">
                                        <!-- NATIVE mac size (bevel-7hf4): the cell renders at the item's true
                                             on-screen size (IconW×IconH, points) — no rescale. TrayRowsPanel
                                             bounds the footprint (16 box-widths/row); it never resizes the icon.
                                             A slot with no decodable icon draws the cell's PLACEHOLDER, not a
                                             blank (bevel-yduf). -->
                                        <tb:TrayIconCell Margin="1,0"
                                                         PointerPressed="OnTrayIconPressed"
                                                         KeyDown="OnTrayIconKeyDown" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Disconnected indicator: a notification-area icon shown only while the taskbar
                         has lost its link to the shell core. It reconnects automatically (backoff),
                         and this clears itself when the link returns.

                         It PULSES, and it is CLICKABLE (bevel-corepulse). A static dot was too easy to
                         miss: a taskbar with no buttons and no tray looks like lost settings rather than
                         a lost core, which is precisely how a real incident was misread. The pulse is a
                         halo that pings outward while the SOLID dot underneath stays fully opaque — the
                         glyph never dims below legibility, so the motion adds urgency without costing
                         clarity. Clicking offers the repairs that actually work (the launcher owns both;
                         RestartCore is the targeted one, and is what fixes an unlinked core socket). -->
                    <Grid x:Name="DisconnectedIndicator" Width="18" Height="18"
                          IsVisible="{Binding IsDisconnected}"
                          VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                          PointerPressed="OnDisconnectedIndicatorPressed"
                          ToolTip.Tip="Disconnected from the shell core — reconnecting… (click to repair)">
                        <Grid.Styles>
                            <!-- Halo only. Animating the dot itself would make the icon fade toward
                                 invisible at the exact moment it most needs to be seen. -->
                            <Style Selector="Grid#DisconnectedIndicator > Ellipse.halo">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="CubicEaseOut">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Setter Property="ScaleTransform.ScaleX" Value="0.62" />
                                            <Setter Property="ScaleTransform.ScaleY" Value="0.62" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="ScaleTransform.ScaleX" Value="1.0" />
                                            <Setter Property="ScaleTransform.ScaleY" Value="1.0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Grid.Styles>
                        <Ellipse Classes="halo" Fill="{DynamicResource Bevel.Brush.HotTracking}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="14" Height="14" Fill="#C0392B" Stroke="#7B241C" StrokeThickness="0.5"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Rectangle Width="9" Height="2.2" RadiusX="1" RadiusY="1" Fill="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="Top">
                                <MenuItem x:Name="RepairRestartCoreItem" Header="Restart shell core"
                                          Click="OnRepairRestartCore"
                                          ToolTip.Tip="Respawns just the core process and rebinds its socket — windows and tray come back without restarting the shell." />
                                <MenuItem x:Name="RepairRestartShellItem" Header="Restart Bevel"
                                          Click="OnRepairRestartShell"
                                          ToolTip.Tip="Restarts every shell process. Use if restarting the core alone doesn't reconnect." />
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </Grid>
                    <tb:ClockWidget x:Name="Clock" VerticalAlignment="Center" />

                    <!-- Show-desktop sliver (Win7 Aero Peek): minimizes every window. Off by default;
                         toggled via Taskbar Properties → Behavior (bevel-cust). -->
                    <Button x:Name="ShowDesktopButton" Width="10" MinWidth="10"
                            Margin="4,1,0,1" Padding="0" Focusable="False" IsVisible="False"
                            Command="{Binding ShowDesktopCommand}"
                            ToolTip.Tip="Show desktop (minimize all windows)"
                            VerticalAlignment="Stretch" />
                </StackPanel>
              </Border>
            </classic:ClassicBorderDecorator>
        </StackPanel>

        <!-- Resize grip: dragging the top edge grows/shrinks the bar in whole button-row steps.
             Transparent (not null) so it's hit-testable; spans the full width. -->
        <Border x:Name="ResizeGrip" Grid.Column="0" Grid.ColumnSpan="3"
                Height="4" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeNorthSouth" />
    </Grid>

        <!-- Win2000 tooltips above task buttons. A Popup (not ToolTip.Tip) positions in screen
             space above the bar; helper isBevelTransient() filters the small parent-PID surface. -->
        <Popup x:Name="TooltipPopup"
               IsLightDismissEnabled="False"
               Placement="Top"
               VerticalOffset="-2"
               WindowManagerAddShadowHint="False">
            <!-- Aero-Peek-style hover panel (bevel-cust): live thumbnail (when Screen Recording is
                 granted) above the window title/status. Thumbnail is hidden until the capture arrives. -->
            <!-- This is the taskbar button tooltip, so it uses the info-tooltip colours (pale yellow face,
                 black text) — the authentic look in BOTH Win2000 and Luna (styleguide). Via Bevel.Brush.*
                 tokens that actually resolve; the classic System*Brush keys are undefined in this app, so
                 they resolved to null and left the whole card transparent (content floated over desktop). -->
            <Border Background="{DynamicResource Bevel.Brush.InfoWindow}"
                    BorderBrush="{DynamicResource Bevel.Brush.InfoText}"
                    BorderThickness="1" Padding="4" MaxWidth="280">
                <StackPanel Spacing="4">
                    <!-- Backing behind the thumbnail: a captured macOS window has transparent rounded
                         corners (and the image can letterbox inside a stretched frame), so without a fill
                         those regions show through the popup. Match the tooltip face so they blend. -->
                    <Border x:Name="PreviewFrame" IsVisible="False"
                            Background="{DynamicResource Bevel.Brush.InfoWindow}"
                            BorderBrush="{DynamicResource Bevel.Brush.ButtonShadow}" BorderThickness="1">
                        <Image x:Name="PreviewImage" MaxWidth="248" MaxHeight="168" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="TaskbarTooltipText"
                               Foreground="{DynamicResource Bevel.Brush.InfoText}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Panel>
</UserControl>
