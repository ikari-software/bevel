<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
             xmlns:tb="clr-namespace:Bevel.Taskbar"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Bevel.Taskbar.StartMenu">
    <!-- UserControl requires a single child; the Popup carries the menu. -->
    <Panel>
        <!--
            The Start menu ships two layouts (bevel-dob) toggled by the active theme in code-behind
            (it is never on screen during a theme change, so a rebuild is safe): the Win2000 single
            column with a navy sidebar banner, and the XP Luna two-column panel (header + pinned /
            places columns + coloured footer) from docs/design/luna/styleguide.html.
        -->
        <Popup x:Name="MenuPopup"
               IsLightDismissEnabled="True"
               Placement="Top"
               WindowManagerAddShadowHint="False">
            <!-- The popup lives in its own visual tree/TopLevel, so the type-to-search key + text handlers
                 (bevel-cezo) are attached to THIS panel in code-behind: keystrokes from either layout — and
                 from the Programs cascade's own nested popup — route up to it. -->
            <Panel x:Name="PopupRoot">
            <!-- ══════════════════ Win2000 layout ══════════════════ -->
            <classic:ClassicBorderDecorator x:Name="ClassicLayout"
                                            BorderStyle="AltRaised"
                                            BorderThickness="2"
                                            Background="{DynamicResource Bevel.Brush.Menu}">
                <Grid ColumnDefinitions="26,*">
                    <!-- Sidebar banner: a vertical caption gradient (dark ActiveTitle → light
                         GradientActiveTitle, the classic title-bar pair) with white product text rotated
                         bottom-to-top. Theme-tokened, so it recolours per scheme/theme (incl. flat). A
                         LayoutTransformControl (not RenderTransform) is used so the rotation participates
                         in layout — otherwise the text is measured against the 26px column width first and
                         truncates to "Bev". -->
                    <Border Grid.Column="0"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="{DynamicResource Bevel.Color.ActiveTitle}" />
                                <GradientStop Offset="1" Color="{DynamicResource Bevel.Color.GradientActiveTitle}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <LayoutTransformControl HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="Bevel"
                                       FontFamily="{DynamicResource Bevel.Font.UI}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Bevel.Brush.ActiveTitleText}" />
                        </LayoutTransformControl>
                    </Border>

                    <!-- Item column: a vertical Menu using the themed dropdown MenuItem, so the
                         selection highlight + icon column track the active theme. -->
                    <!-- 1px left gutter so the item icons don't sit flush against the sidebar banner.
                         Win2000's own Start menu leaves a hairline there; without it the icon glyphs read
                         as welded to the stripe, which is the first thing the eye catches. -->
                    <DockPanel Grid.Column="1" Margin="1,0,0,0">
                    <!-- Type-to-search strip (bevel-cezo): hidden until the user types with the menu open,
                         then it shows the live query and the match count above the item column, in a
                         sunken edit-field frame. Nested Borders — NOT ClassicBorderDecorator / BevelBorder:
                         both Decorator-based edge painters force an intermediate composition layer that
                         SiteShot's 2× RenderTargetBitmap paints wrong (glyphs enormous + clipped,
                         bevel-qgv9; same class as theme-win2000's TabControl). -->
                    <Border x:Name="ClassicSearchStrip"
                            DockPanel.Dock="Top"
                            IsVisible="False"
                            Margin="3,3,3,2"
                            BorderBrush="{DynamicResource Bevel.Brush.ButtonHighlight}"
                            BorderThickness="0,0,1,1">
                        <Border BorderBrush="{DynamicResource Bevel.Brush.ButtonShadow}"
                                BorderThickness="1,1,0,0">
                            <Border BorderBrush="{DynamicResource Bevel.Brush.ButtonLight}"
                                    BorderThickness="0,0,1,1">
                                <Border BorderBrush="{DynamicResource Bevel.Brush.ButtonDkShadow}"
                                        BorderThickness="1,1,0,0"
                                        Background="{DynamicResource Bevel.Brush.Window}"
                                        Padding="4,3">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Code-drawn magnifier on the shared 16-grid; theme-tokened, vector-only. -->
                                        <Canvas Width="14" Height="14" VerticalAlignment="Center" ClipToBounds="True">
                                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="9" Height="9"
                                                     Stroke="{DynamicResource Bevel.Brush.WindowText}" StrokeThickness="1.4" />
                                            <Path Data="M9.5,9.5 L13,13"
                                                  Stroke="{DynamicResource Bevel.Brush.WindowText}"
                                                  StrokeThickness="1.6" StrokeLineCap="Round" />
                                        </Canvas>
                                        <TextBlock x:Name="ClassicSearchText"
                                                   FontFamily="{DynamicResource Bevel.Font.UI}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Bevel.Brush.WindowText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="ClassicSearchCount"
                                                   FontFamily="{DynamicResource Bevel.Font.UI}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Bevel.Brush.GrayText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Border>
                    </Border>

                    <Menu x:Name="ItemsMenu"
                          MinWidth="180"
                          Background="{DynamicResource Bevel.Brush.Menu}"
                          ItemContainerTheme="{DynamicResource Bevel.Theme.MenuItem}">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>

                        <!-- Cascading groups (children populated in code-behind). -->
                        <MenuItem x:Name="ProgramsItem" Header="_Programs" />
                        <MenuItem x:Name="DocumentsItem" Header="_Documents" />
                        <MenuItem x:Name="SettingsItem" Header="_Settings" />
                        <MenuItem x:Name="SearchItem" Header="Sea_rch" />

                        <!-- Leaves. -->
                        <MenuItem x:Name="HelpItem" Header="_Help" Click="OnHelpClick" />
                        <MenuItem x:Name="RunItem" Header="_Run…" Click="OnRunClick" />
                        <!-- Show/Hide the desktop surface on demand (bevel-gdie): the desktop-role child
                             is OFF by default, spawned/killed here via the launcher. Header flips to
                             "Hide Desktop" while it's up. -->
                        <MenuItem x:Name="DesktopItem" Header="Show _Desktop" Click="OnToggleDesktopClick" />

                        <Separator />

                        <MenuItem x:Name="LogOffItem" Header="L_og Off…" Click="OnLogOffClick" />
                        <MenuItem x:Name="ShutDownItem" Header="Sh_ut Down…" Click="OnShutDownClick" />

                        <Separator />

                        <MenuItem x:Name="RestartItem" Header="_Restart Bevel" Click="OnRestartClick" />
                        <MenuItem x:Name="QuitItem" Header="_Quit Bevel" Click="OnQuitClick" />
                    </Menu>
                    </DockPanel>
                </Grid>
            </classic:ClassicBorderDecorator>

            <!-- ══════════════════ XP Luna layout ══════════════════ -->
            <!-- Fixed tall panel like the real XP Start menu (styleguide is 440x560): without a height
                 the menu just sizes to content, so the capped frequent column + short places column make
                 it look squat. MinHeight keeps it tall — pinned items sit at the top, the columns fill
                 down (white / pale-blue), and All Programs stays anchored at the bottom. -->
            <Border x:Name="Blue2001Layout" IsVisible="False" Classes="start-layout"
                    Width="{DynamicResource Flat.Metric.StartMenuWidth}" MinHeight="{DynamicResource Flat.Metric.StartMenuHeight}" CornerRadius="{DynamicResource Flat.Metric.StartMenuCornerRadius}"
                    BorderBrush="{DynamicResource Blue2001.Brush.StartMenuBorder}" BorderThickness="1"
                    ClipToBounds="True" Background="{DynamicResource Blue2001.Brush.StartMenuPinnedColumn}">
                <Border.Styles>
                    <!-- Left-column pinned item + right-column place: flat until hover, then the blue
                         full-row Luna selection with white text. -->
                    <Style Selector="Button.lunarow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <ControlTemplate TargetType="Button">
                                <Border Name="row" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Flat.Metric.StartMenuRowCornerRadius}">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.lunarow:pointerover /template/ Border#row">
                        <Setter Property="Background" Value="{DynamicResource Bevel.Brush.Highlight}" />
                    </Style>
                    <!-- Visible keyboard focus (WCAG 2.4.7, bevel-vk4n): a focused pinned/place row gets
                         the same blue Luna selection as hover, so arrowing the menu is never invisible. -->
                    <Style Selector="Button.lunarow:focus-visible /template/ Border#row">
                        <Setter Property="Background" Value="{DynamicResource Bevel.Brush.Highlight}" />
                    </Style>
                    <Style Selector="Button.lunarow:focus-visible TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="TextBlock.pintitle">
                        <Setter Property="Foreground" Value="{DynamicResource Blue2001.Brush.StartMenuPinTitle}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                    <Style Selector="TextBlock.pinsub">
                        <Setter Property="Foreground" Value="{DynamicResource Blue2001.Brush.StartMenuPinSub}" />
                        <Setter Property="FontSize" Value="11" />
                    </Style>
                    <Style Selector="TextBlock.place">
                        <Setter Property="Foreground" Value="{DynamicResource Blue2001.Brush.StartMenuPlaceText}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <!-- Hover foreground LAST so it beats the per-class foregrounds above: Avalonia styles
                         win by document order, so if this came first the hovered row kept dark text on the
                         blue highlight. Covers pintitle, pinsub and place (all descendant TextBlocks). -->
                    <Style Selector="Button.lunarow:pointerover TextBlock">
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                    <Style Selector="Button.footer">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <ControlTemplate TargetType="Button">
                                <Border Name="fr" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Flat.Metric.StartMenuRowCornerRadius}">
                                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.footer:pointerover /template/ Border#fr">
                        <Setter Property="Background" Value="{DynamicResource Blue2001.Brush.StartMenuFooterHover}" />
                    </Style>
                    <!-- Visible keyboard focus for the footer Log Off / Turn Off buttons (WCAG 2.4.7). -->
                    <Style Selector="Button.footer:focus-visible /template/ Border#fr">
                        <Setter Property="Background" Value="{DynamicResource Blue2001.Brush.StartMenuFooterHover}" />
                    </Style>
                    <Style Selector="Button.footer-round">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.footer-round:pointerover">
                        <Setter Property="Opacity" Value="0.85" />
                    </Style>
                    <Style Selector="Button.footer-round:pressed">
                        <Setter Property="Opacity" Value="0.7" />
                    </Style>
                    <!-- Flat/Whistler source skin: compact, square-pixel plates with warm-gray faces. -->
                </Border.Styles>

                <DockPanel>
                    <!-- Header: blue gradient with avatar + user name -->
                    <Border x:Name="Blue2001Header" DockPanel.Dock="Top" Height="{DynamicResource Flat.Metric.StartMenuHeaderHeight}" Padding="14,0"
                            Background="{DynamicResource Blue2001.Brush.StartMenuHeader}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="11">
                            <Border x:Name="Blue2001Avatar" Width="40" Height="40" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}"
                                    BorderBrush="White" BorderThickness="2"
                                    Background="{DynamicResource Blue2001.Brush.StartMenuAvatar}">
                                <Canvas Width="40" Height="40">
                                    <Ellipse Canvas.Left="13" Canvas.Top="8" Width="14" Height="14" Fill="#FFFFFF" Opacity="0.92" />
                                    <Path Data="M8 34 Q20 18 32 34 Z" Fill="#FFFFFF" Opacity="0.92" />
                                </Canvas>
                            </Border>
                            <TextBlock x:Name="Blue2001UserName" Text="User"
                                       Foreground="White" FontWeight="Bold" FontSize="17"
                                       VerticalAlignment="Center">
                                <!-- Subtle dark shadow so white name stays legible over the light top of
                                     the header gradient (the plate uses a dark text stroke). AA stays on. -->
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#123A8F" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="0.55" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!-- Orange banded separator under the header -->
                    <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource Blue2001.Brush.StartMenuHeaderRule}" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Blue2001.Brush.StartMenuHeaderRuleLight}" Opacity="0.7" />

                    <!-- Type-to-search strip (bevel-cezo): hidden until the user types with the menu open,
                         then it shows the live query + match count while the pinned column below turns into
                         the ranked result list. Rounded Luna field on the pale-blue band. -->
                    <Border x:Name="Blue2001SearchStrip" DockPanel.Dock="Top" IsVisible="False"
                            Padding="10,7"
                            Background="{DynamicResource Blue2001.Brush.StartMenuPlacesColumn}">
                        <Border CornerRadius="{DynamicResource Flat.Metric.StartMenuRowCornerRadius}" Padding="7,4"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}"
                                Background="{DynamicResource Blue2001.Brush.StartMenuPinnedColumn}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Canvas Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="9" Height="9"
                                             Stroke="#2F6FD0" StrokeThickness="1.6" />
                                    <Path Data="M9.5,9.5 L13,13" Stroke="#2F6FD0"
                                          StrokeThickness="1.8" StrokeLineCap="Round" />
                                </Canvas>
                                <TextBlock x:Name="Blue2001SearchText" FontSize="13"
                                           Foreground="{DynamicResource Blue2001.Brush.StartMenuPlaceText}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="Blue2001SearchCount" FontSize="11" Opacity="0.65"
                                           Foreground="{DynamicResource Blue2001.Brush.StartMenuPlaceText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Footer: coloured band with Search bar on left, Log Off / Turn Off on right -->
                    <Border x:Name="Blue2001Footer" DockPanel.Dock="Bottom" Height="{DynamicResource Flat.Metric.StartMenuFooterHeight}"
                            Background="{DynamicResource Blue2001.Brush.StartMenuFooter}">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="2"
                                    Background="{DynamicResource Blue2001.Brush.StartMenuFooterRule}" />
                            <Border x:Name="FlatFooterSearch" DockPanel.Dock="Left" Margin="8,0,0,0" Height="24" Width="160"
                                    Background="White" BorderBrush="{DynamicResource Flat.Brush.Border}" BorderThickness="1"
                                    CornerRadius="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0">
                                    <Canvas Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="7" Height="7" Stroke="#68799A" StrokeThickness="1.4" />
                                        <Path Data="M7,7 L11,11" Stroke="#68799A" StrokeThickness="1.5" StrokeLineCap="Round" />
                                    </Canvas>
                                    <TextBlock Text="Search" FontSize="11" Foreground="#8A8598" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Classes="footer-round" Click="OnBlue2001LogOffClick" ToolTip.Tip="Log Off">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Flat.Brush.FooterRoundButton}"
                                        BorderBrush="{DynamicResource Flat.Brush.FooterRoundButtonBorder}" BorderThickness="1">
                                    <!-- Log Off = exit-through-door, on the shared 24-grid (centred at 12,12); fixed-Canvas render. -->
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M13,6 L7,6 L7,18 L13,18 M10,12 L17,12 M14.5,9.5 L17,12 L14.5,14.5"
                                                  Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Button>
                            <Button Classes="footer-round" Click="OnBlue2001TurnOffClick" ToolTip.Tip="Turn Off">
                                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Flat.Brush.FooterRoundButton}"
                                        BorderBrush="{DynamicResource Flat.Brush.FooterRoundButtonBorder}" BorderThickness="1">
                                    <!-- Turn Off = power symbol on the shared 24-grid (ring r6 at 12,12). Same glyph as Quit. -->
                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 4.8 V12 M7.2 8.4 A6 6 0 1 0 16.8 8.4"
                                                  Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Body: pinned (left, white) + places (right, pale-blue) -->
                    <Grid ColumnDefinitions="*,158" Background="{DynamicResource Blue2001.Brush.StartMenuPlacesColumn}">
                        <!-- Left column: inset white rounded rectangle with blue on the left and around it -->
                        <Border Grid.Column="0" Margin="7,6,3,6" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource Blue2001.Brush.StartMenuPinnedColumn}">
                            <DockPanel>
                            <!-- All Programs, bottom-anchored — the Button is bottom-most so the divider (docked
                                 bottom AFTER it) renders directly above it, not floored against the footer. -->
                            <Button x:Name="Blue2001AllProgramsButton" DockPanel.Dock="Bottom" Classes="lunarow" Padding="10,7"
                                    HorizontalContentAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="All Programs" Classes="pintitle" VerticalAlignment="Center" />
                                    <Border Width="20" Height="20" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}"
                                            Background="{DynamicResource Blue2001.Brush.StartMenuAllProgramsGlyph}">
                                        <Path Data="M0,0 L6,4.5 L0,9 Z" Fill="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Blue2001.Brush.StartMenuDivider}" Margin="12,0" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="Blue2001Pinned">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="tb:ProgramItemViewModel">
                                            <Button Classes="lunarow" Command="{Binding LaunchCommand}"
                                                    Click="OnBlue2001ProgramClick">
                                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <!-- Icon slot: a neutral rounded tile shows while the real
                                                         icon loads off-thread (or if the provider yields none),
                                                         so a pinned row is never a hollow gap. -->
                                                    <Panel Width="28" Height="28" VerticalAlignment="Center">
                                                        <Border CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}"
                                                                Background="{DynamicResource Blue2001.Brush.StartMenuPinIconFallback}"
                                                                IsVisible="{Binding IconSource, Converter={x:Static conv:ObjectConverters.IsNull}}">
                                                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Fill="#8AA0C4"
                                                                  Data="M7,8 H21 V20 H7 Z M7,8 V11 H21" />
                                                        </Border>
                                                        <Image Source="{Binding IconSource}" Width="28" Height="28"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    </Panel>
                                                    <!-- Two-line featured entry: bold name + grey category sub-label
                                                         (design). Apps with no category collapse to a single line. -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Classes="pintitle" />
                                                        <TextBlock Text="{Binding SubLabel}" Classes="pinsub"
                                                                   IsVisible="{Binding HasSubLabel}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Right column: places + system. The Border carries the pale-blue and fills the
                             full (taller) column; a vertical StackPanel only sizes to content, so it sits at
                             the top and the space below stays pale-blue instead of showing the white face. -->
                        <Border Grid.Column="1" Background="{DynamicResource Blue2001.Brush.StartMenuPlacesColumn}">
                        <StackPanel Spacing="1" VerticalAlignment="Top">
                            <Button Classes="lunarow" Click="OnBlue2001PlaceClick" Tag="documents">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconFolder}">
                                        <Panel>
                                            <Path Fill="White" Data="M7.5,5 L13.5,5 L16.5,8 L16.5,19 L7.5,19 Z" />
                                            <Path Fill="#D4DBEA" Data="M13.5,5 L13.5,8 L16.5,8 Z" />
                                            <Path Stroke="#4C7FD0" StrokeThickness="1" Data="M9.5,10.5 H14.5 M9.5,13.5 H14.5 M9.5,16.5 H13" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="My Documents" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001PlaceClick" Tag="pictures">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconFolder}">
                                        <Panel>
                                            <Path Fill="White" Data="M6,6.5 L18,6.5 L18,17.5 L6,17.5 Z" />
                                            <Path Fill="#F5C842" Data="M12,10 A2.5,2.5 0 1 1 17,10 A2.5,2.5 0 1 1 12,10 Z" />
                                            <Path Fill="#4CA64C" Data="M6,17.5 L10,12 L13,15.5 L15.5,13 L18,17.5 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="My Pictures" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001PlaceClick" Tag="music">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconFolder}">
                                        <Panel>
                                            <Path Fill="#2A6FD0" Data="M13,7.4 L14.2,7.4 L14.2,16.4 L13,16.4 Z" />
                                            <Path Fill="#2A6FD0" Data="M13,7.4 C15.6,7.8 15.8,10.4 14.6,11.4 L14.2,10.6 C15,10 14.8,8.5 13,8.3 Z" />
                                            <Path Fill="#2A6FD0" Data="M9,15 A2.1,1.7 0 1 1 13.2,15 A2.1,1.7 0 1 1 9,15 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="My Music" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001PlaceClick" Tag="computer">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuComputerIcon}">
                                        <Panel>
                                            <Path Fill="White" Data="M6,6 L18,6 L18,15 L6,15 Z" />
                                            <Path Fill="#AFCDF2" Data="M7,7 L17,7 L17,14 L7,14 Z" />
                                            <Path Fill="White" Data="M10.5,15 L13.5,15 L14.5,18 L9.5,18 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="My Computer" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Border Height="1" Background="{DynamicResource Blue2001.Brush.StartMenuPlacesDivider}" Margin="10,4" />
                            <Button Classes="lunarow" Click="OnBlue2001SettingsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconGeneric}" BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}" BorderThickness="1">
                                        <Panel>
                                            <Path Stroke="#5A6472" StrokeThickness="1.4" Data="M5.5,9.5 H18.5 M5.5,15 H18.5" />
                                            <Path Fill="#4CA64C" Stroke="#2C6B2C" StrokeThickness="1" Data="M7.5,9.5 A2,2 0 1 1 11.5,9.5 A2,2 0 1 1 7.5,9.5 Z" />
                                            <Path Fill="#2A6FD0" Stroke="#1B4E9E" StrokeThickness="1" Data="M12.5,15 A2,2 0 1 1 16.5,15 A2,2 0 1 1 12.5,15 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="Control Panel" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001BevelSettingsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconGeneric}" BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}" BorderThickness="1">
                                        <Panel>
                                            <Path Fill="White" Stroke="#5A6472" StrokeThickness="1" Data="M5,7 H19 V17 H5 Z" />
                                            <Path Fill="#2A6FD0" Data="M5,7 H19 V10 H5 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="Bevel Settings" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001HelpClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuHelpIcon}">
                                        <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Help and Support" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001SearchClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconGeneric}" BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}" BorderThickness="1">
                                        <Panel>
                                            <Path Stroke="#2F6FD0" StrokeThickness="2" StrokeLineCap="Round" Data="M13,13 L17.5,17.5" />
                                            <Path Fill="#DCEBFF" Stroke="#2F6FD0" StrokeThickness="1.8" Data="M7.1,10.5 A3.4,3.4 0 1 1 13.9,10.5 A3.4,3.4 0 1 1 7.1,10.5 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="Search" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnBlue2001RunClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconGeneric}" BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}" BorderThickness="1">
                                        <Panel>
                                            <Path Fill="White" Stroke="#7B93B8" StrokeThickness="1" Data="M6,7 L18,7 L18,17 L6,17 Z" />
                                            <Path Fill="#2F6FD0" Data="M6,7 L18,7 L18,9.5 L6,9.5 Z" />
                                            <Path Fill="#3FA23F" Data="M8.5,13.5 L12.5,13.5 L12.5,11.5 L15.5,14 L12.5,16.5 L12.5,14.5 L8.5,14.5 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="Run…" Classes="place" />
                                </StackPanel>
                            </Button>
                            <!-- Bevel shell-management actions (parity with the Win2000 "Restart Bevel" /
                                 "Quit Bevel" items), surfaced honestly here rather than hidden behind the
                                 footer's Log Off / Turn Off wording. -->
                            <Border Height="1" Background="{DynamicResource Blue2001.Brush.StartMenuPlacesDivider}" Margin="10,4" />
                            <!-- Show/Hide Desktop (bevel-gdie): spawns/kills the desktop-role child on demand.
                                 Blue2001DesktopText flips to "Hide Desktop" while the surface is up. -->
                            <Button x:Name="Blue2001DesktopButton" Classes="lunarow" Click="OnToggleDesktopClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuPlaceIconGeneric}" BorderBrush="{DynamicResource Blue2001.Brush.StartMenuPlaceIconBorder}" BorderThickness="1">
                                        <!-- Desktop = monitor screen + stand, on the shared 24-grid. -->
                                        <Panel>
                                            <Path Fill="White" Stroke="#5A6472" StrokeThickness="1" Data="M5,6.5 L19,6.5 L19,15.5 L5,15.5 Z" />
                                            <Path Fill="#2A6FD0" Data="M6.5,8 L17.5,8 L17.5,14 L6.5,14 Z" />
                                            <Path Fill="#5A6472" Data="M10.5,15.5 L13.5,15.5 L14.5,18 L9.5,18 Z" />
                                        </Panel>
                                    </Border>
                                    <TextBlock x:Name="Blue2001DesktopText" Text="Show Desktop" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnRestartClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuLogOffIcon}">
                                        <!-- All four session glyphs are authored in ONE shared 24x24 grid (matched size, circle
                                             centred at 12,12) and rendered through a fixed 24-Canvas in the Viewbox, so the GRID maps
                                             to the button — not each glyph's own bounding box. That keeps every glyph the same size and
                                             lands the circle centre exactly on the button centre (a bare ring at 12,12 hits dead-centre).
                                             Restart = a clean clockwise circular arrow (arc + chevron head). -->
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                                                      Data="M18,12 A6,6 0 1 1 12,6 M12,3.83 L15.58,6 L12,8.17" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Restart Bevel" Classes="place" />
                                </StackPanel>
                            </Button>
                            <Button Classes="lunarow" Click="OnQuitClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="{DynamicResource Flat.Metric.StartMenuIconCornerRadius}" Background="{DynamicResource Blue2001.Brush.StartMenuTurnOffIcon}">
                                        <!-- Quit = power symbol on the shared 24-grid: ring r6 centred at (12,12), bar down the middle.
                                             Same glyph as the footer Turn Off. -->
                                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="White" StrokeThickness="2" StrokeLineCap="Round"
                                                      Data="M12 4.8 V12 M7.2 8.4 A6 6 0 1 0 16.8 8.4" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="Quit Bevel" Classes="place" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
            </Panel>
        </Popup>
    </Panel>
</UserControl>
