<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
             x:Class="Bevel.Taskbar.StartMenu">
    <!-- UserControl requires a single child; the Popup carries the menu. -->
    <Panel>
        <!--
            Win2000 Start menu (bevel-m2.11). The item column is a vertical Menu whose
            items are rendered with the DEFAULT MenuItem ControlTheme (ItemContainerTheme
            below) rather than the menu-BAR theme a Menu normally applies — so every row
            gets the classic full-row COLOR_HIGHLIGHT (#0A246A) selection with white text,
            a reserved 19px icon column, the black cascade arrow, and etched separators,
            all straight from the theme (docs/reference/win2000/taskbar-start-menu.md).
            The whole thing sits in a raised 3D ClassicBorderDecorator, with the navy
            sidebar banner to its left — the one piece of custom chrome a menu can't supply.
        -->
        <Popup x:Name="MenuPopup"
               IsLightDismissEnabled="True"
               Placement="Top"
               WindowManagerAddShadowHint="False">
            <classic:ClassicBorderDecorator BorderStyle="AltRaised"
                                            BorderThickness="2"
                                            Background="{DynamicResource Bevel.Brush.Menu}">
                <Grid ColumnDefinitions="26,*">
                    <!-- Sidebar banner: flat navy (#0A246A, the theme's active-title/
                         highlight navy) with white product text rotated bottom-to-top.
                         A LayoutTransformControl (not RenderTransform) is used so the
                         rotation participates in layout — otherwise the text is measured
                         against the 26px column width first and truncates to "Bev". -->
                    <Border Grid.Column="0"
                            ClipToBounds="True"
                            Background="{DynamicResource Bevel.Brush.ActiveTitle}">
                        <LayoutTransformControl HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="Bevel"
                                       FontFamily="{DynamicResource Bevel.Font.UI}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Bevel.Brush.ActiveTitleText}" />
                        </LayoutTransformControl>
                    </Border>

                    <!-- Item column: a vertical Menu using the default MenuItem theme. -->
                    <Menu Grid.Column="1"
                          x:Name="ItemsMenu"
                          MinWidth="180"
                          Background="{DynamicResource Bevel.Brush.Menu}"
                          ItemContainerTheme="{StaticResource {x:Type MenuItem}}">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>

                        <!-- Cascading groups (children populated in code-behind). -->
                        <MenuItem x:Name="ProgramsItem" Header="_Programs" />
                        <MenuItem x:Name="DocumentsItem" Header="_Documents" />
                        <MenuItem x:Name="SettingsItem" Header="_Settings" />
                        <MenuItem x:Name="SearchItem" Header="Sea_rch" />

                        <!-- Leaves. -->
                        <MenuItem x:Name="HelpItem" Header="_Help" Click="OnHelpClick" />
                        <MenuItem x:Name="RunItem" Header="_Run…" Click="OnRunClick" />

                        <Separator />

                        <MenuItem x:Name="LogOffItem" Header="L_og Off…" Click="OnLogOffClick" />
                        <MenuItem x:Name="ShutDownItem" Header="Sh_ut Down…" Click="OnShutDownClick" />
                    </Menu>
                </Grid>
            </classic:ClassicBorderDecorator>
        </Popup>
    </Panel>
</UserControl>
