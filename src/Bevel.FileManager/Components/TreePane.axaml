<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bevel.FileManager.Components"
             x:Class="Bevel.FileManager.Components.TreePane"
             x:Name="Root"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Win2000 3D sunken border around the tree -->
        <Style Selector="Border.TreeBorder">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="Background" Value="#FFFFFFFF" />
        </Style>

        <!-- TreeView with Win2000 3D sunken look -->
        <Style Selector="TreeView.TreeView">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontFamily" Value="Tahoma, sans-serif" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- TreeViewItem styling for Win2000 tree lines -->
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="1,1,1,1" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Selected item highlight — Win2000 system highlight -->
        <Style Selector="TreeViewItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF0A246A" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- Hover highlight -->
        <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFD4D0C8" />
        </Style>
    </UserControl.Styles>

    <Border Classes="TreeBorder">
        <DockPanel>
            <!-- Label at top -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Folders"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="4,4,4,2"
                       Background="#FFD4D0C8"
                       Padding="2,1" />

            <!-- Tree -->
            <TreeView x:Name="FolderTree"
                      Classes="TreeView"
                      ItemsSource="{Binding Children}"
                      SelectedItem="{Binding SelectedNode}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <TreeView.ItemContainerTheme>
                    <ControlTheme TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="ItemsSource" Value="{Binding Children}" />
                    </ControlTheme>
                </TreeView.ItemContainerTheme>

                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Panel Width="16" Height="16">
                                <TextBlock x:Name="FolderIcon"
                                           Text="&#x1F4C1;"
                                           FontSize="12"
                                           IsVisible="{Binding IsFolder}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="FileIcon"
                                           Text="&#x1F4C4;"
                                           FontSize="12"
                                           IsVisible="{Binding IsFile}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Panel>

                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Margin="1,0,0,0" />

                            <TextBlock Text="..."
                                       IsVisible="{Binding IsLoading}"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="Gray"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>
