<ui:BevelWindow xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="using:Bevel.UI"
         x:Class="Bevel.FileManager.Components.FolderPickerDialog"
         Title="Browse For Folder"
         Width="320" Height="400"
         MinWidth="260" MinHeight="300"
         WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10" Background="#D4D0C8">
        <TextBlock DockPanel.Dock="Top" Text="Select a folder:" Margin="0,0,0,6" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" Width="75" Height="23" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="Cancel" Width="75" Height="23" />
        </StackPanel>

        <ui:BevelBorder BevelStyle="Sunken" Face="White">
            <TreeView x:Name="TreeView" Background="White" BorderThickness="0" />
        </ui:BevelBorder>
    </DockPanel>
</ui:BevelWindow>
