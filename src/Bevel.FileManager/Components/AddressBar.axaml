<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
             xmlns:ui="clr-namespace:Bevel.UI;assembly=Bevel.UI"
             x:Class="Bevel.FileManager.Components.AddressBar">

    <DockPanel>
        <!-- "Address" label -->
        <TextBlock DockPanel.Dock="Left"
                   Text="Address"
                   VerticalAlignment="Center"
                   Margin="4,0,4,0"
                   FontSize="11" />

        <!-- Go button -->
        <Button DockPanel.Dock="Right"
                x:Name="GoButton"
                Content="Go"
                MinWidth="50"
                MinHeight="22"
                Margin="4,0,4,0"
                Click="OnGoClick" />

        <!-- Editable path field: a sunken TextBox with a leading folder icon and a
             dropdown chevron, matching the Win2000 Explorer address combo. (The Classic
             editable ComboBox doesn't render its Text reliably, so this uses a TextBox.)
             The PATH text is pinned LeftToRight even when the surrounding chrome mirrors
             under RTL (bevel-3cd): filesystem paths are LTR strings ('/' separators read
             left-to-right), matching classic Filer's RTL behavior. -->
        <Grid>
            <TextBox x:Name="AddressBox"
                     MinHeight="22"
                     FontSize="11"
                     Padding="22,1,18,1"
                     VerticalContentAlignment="Center"
                     FlowDirection="LeftToRight"
                     AutomationProperties.Name="Address"
                     KeyDown="OnAddressKeyDown" />

            <!-- Folder icon: THE list glyph, hosted — not a transcription of it. This used to carry
                 its own copy of both paths (so correcting the back panel's shape in Glyphs.cs left it
                 drawing a rectangle behind a trapezoid, c98431d), then bound the geometry but kept
                 three hex literals for the fills (so it stayed the same gold under every skin while
                 the list's folders recoloured, bevel-i9iu). GlyphIcon builds the same icon from the
                 same token brushes and rebuilds it whenever a theme/scheme/variant switch drops them. -->
            <ui:GlyphIcon Glyph="folder" Size="16"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="4,0,0,0" IsHitTestVisible="False" />

            <!-- Dropdown chevron (history dropdown wired later) -->
            <shapes:Path HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,5,0" Data="M0,0 L8,0 L4,4 Z"
                         Fill="#404040" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</UserControl>
