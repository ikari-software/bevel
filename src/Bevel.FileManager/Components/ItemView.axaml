<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bevel.FileManager.Components"
             x:Class="Bevel.FileManager.Components.ItemView"
             Focusable="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Details column headers -->
        <!-- Raised button-style column headers (white top-left highlight, #808080
             bottom-right shadow), on the Win2000 face colour. -->
        <Border x:Name="ColumnHeaders"
                Grid.Row="0"
                Background="#D4D0C8"
                IsVisible="False"
                Height="18">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="*,80,120,140">
                <Border Grid.Column="0" BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Border BorderBrush="White" BorderThickness="1,1,0,0" Background="#D4D0C8">
                        <TextBlock x:Name="SortName" Tag="Name" Text=" Name" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                   Cursor="Hand" PointerPressed="OnHeaderClick" />
                    </Border>
                </Border>
                <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="White" BorderThickness="1,1,0,0" Background="#D4D0C8">
                            <TextBlock x:Name="SortSize" Tag="Size" Text=" Size" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="SizeGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
                <Border Grid.Column="2" BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="White" BorderThickness="1,1,0,0" Background="#D4D0C8">
                            <TextBlock x:Name="SortType" Tag="Type" Text=" Type" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="TypeGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
                <Border Grid.Column="3" BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="White" BorderThickness="1,1,0,0" Background="#D4D0C8">
                            <TextBlock x:Name="SortModified" Tag="Modified" Text=" Date Modified" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="DateGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- Items + marquee overlay -->
        <Panel x:Name="ItemsHost" Grid.Row="1">
            <ScrollViewer x:Name="ItemsScroller"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="White">
                <ItemsControl x:Name="ItemsPresenter"
                              Focusable="False" />
            </ScrollViewer>
            <Canvas x:Name="MarqueeCanvas"
                    IsHitTestVisible="False"
                    Background="Transparent">
                <Rectangle x:Name="MarqueeRect"
                           Fill="#220066FF"
                           Stroke="#CC0066FF"
                           StrokeThickness="1"
                           StrokeDashArray="3,2"
                           IsVisible="False" />
            </Canvas>
        </Panel>
    </Grid>

</UserControl>
