<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Bevel.FileManager.Components"
             x:Class="Bevel.FileManager.Components.ItemView"
             Focusable="True">

    <Grid RowDefinitions="Auto,*">
        <!-- Details column headers -->
        <!-- Raised button-style column headers (ButtonHighlight top-left, ButtonShadow
             bottom-right — the thin-raised bevel), on the theme face colour (bevel-38y). -->
        <Border x:Name="ColumnHeaders"
                Grid.Row="0"
                Background="{DynamicResource Flat.Brush.ColumnHeader}"
                BorderBrush="{DynamicResource Flat.Brush.ColumnSeparator}"
                BorderThickness="0,0,0,1"
                IsVisible="False"
                Height="18">
            <Grid x:Name="HeaderGrid" ColumnDefinitions="*,80,120,140">
                <Border Grid.Column="0" BorderBrush="{DynamicResource Flat.Brush.ColumnSeparator}" BorderThickness="0,0,1,1">
                    <Border BorderBrush="{DynamicResource Flat.Brush.ColumnHeaderLight}" BorderThickness="1,1,0,0" Background="{DynamicResource Flat.Brush.ColumnHeader}">
                        <TextBlock x:Name="SortName" Tag="Name" Text=" Name" FontSize="11"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                   Cursor="Hand" PointerPressed="OnHeaderClick" />
                    </Border>
                </Border>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Flat.Brush.ColumnSeparator}" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="{DynamicResource Flat.Brush.ColumnHeaderLight}" BorderThickness="1,1,0,0" Background="{DynamicResource Flat.Brush.ColumnHeader}">
                            <TextBlock x:Name="SortSize" Tag="Size" Text=" Size" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="SizeGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
                <Border Grid.Column="2" BorderBrush="{DynamicResource Flat.Brush.ColumnSeparator}" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="{DynamicResource Flat.Brush.ColumnHeaderLight}" BorderThickness="1,1,0,0" Background="{DynamicResource Flat.Brush.ColumnHeader}">
                            <TextBlock x:Name="SortType" Tag="Type" Text=" Type" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="TypeGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
                <Border Grid.Column="3" BorderBrush="{DynamicResource Flat.Brush.ColumnSeparator}" BorderThickness="0,0,1,1">
                    <Panel>
                        <Border BorderBrush="{DynamicResource Flat.Brush.ColumnHeaderLight}" BorderThickness="1,1,0,0" Background="{DynamicResource Flat.Brush.ColumnHeader}">
                            <TextBlock x:Name="SortModified" Tag="Modified" Text=" Date Modified" FontSize="11"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="4,0"
                                       Cursor="Hand" PointerPressed="OnHeaderClick" />
                        </Border>
                        <Thumb x:Name="DateGrip" Width="6" HorizontalAlignment="Right" Cursor="SizeWestEast" Background="Transparent">
                            <Thumb.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- Items + marquee overlay -->
        <Panel x:Name="ItemsHost" Grid.Row="1">
            <ScrollViewer x:Name="ItemsScroller"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Bevel.Brush.Window}">
                <local:ItemList x:Name="ItemsPresenter"
                              Focusable="False"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Stretch" />
            </ScrollViewer>
            <!-- Focus-visible cue: shown only while the list is focused with nothing selected
                 (see UpdateFocusCue). Subtle dotted rectangle in the theme text colour. -->
            <Rectangle x:Name="FocusCue"
                       IsHitTestVisible="False"
                       IsVisible="False"
                       Margin="1"
                       Stroke="{DynamicResource Bevel.Brush.WindowText}"
                       StrokeThickness="1"
                       StrokeDashArray="1,2"
                       Opacity="0.5" />
            <Canvas x:Name="MarqueeCanvas"
                    IsHitTestVisible="False"
                    Background="Transparent">
                <Rectangle x:Name="MarqueeRect"
                           Fill="#220066FF"
                           Stroke="#CC0066FF"
                           StrokeThickness="1"
                           StrokeDashArray="3,2"
                           IsVisible="False" />
            </Canvas>
        </Panel>
    </Grid>

</UserControl>
