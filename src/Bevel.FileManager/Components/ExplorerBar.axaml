<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bevel.FileManager.Components.ExplorerBar"
             Focusable="False">

    <!-- Win2000 Explorer Bar: title bar + content area with sunken 3D border -->
    <Grid RowDefinitions="Auto,*">
        <!-- Title bar: "Folders" label + close button -->
        <Border Grid.Row="0"
                Height="22"
                Background="{DynamicResource SystemGradientBrush}"
                BorderBrush="{DynamicResource SystemControlDarkBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="4,0">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Width="16" Height="14"
                        Margin="2,2,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <Path Width="8" Height="8"
                          Stroke="{DynamicResource SystemControlTextBrush}"
                          StrokeThickness="1"
                          Data="M0,0 L8,8 M8,0 L0,8" />
                </Button>
                <TextBlock x:Name="TitleLabel"
                           Text="Folders"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Content area: sunken 3D border + tree -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlDarkBrush}"
                BorderThickness="1,0,1,1"
                Padding="1"
                Background="{DynamicResource SystemWindowColor}">
            <ContentControl x:Name="ContentHost" />
        </Border>
    </Grid>
</UserControl>