<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Bevel.FileManager.Components"
             x:Class="Bevel.FileManager.Components.SearchPane"
             x:Name="Root"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Win2000 3D sunken border for the search pane -->
        <Style Selector="Border.SearchBorder">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="Background" Value="#FFD4D0C8" />
        </Style>

        <!-- Win2000 sunken text box look -->
        <Style Selector="TextBox.Sunken">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MaxHeight" Value="22" />
        </Style>

        <!-- Win2000 flat button -->
        <Style Selector="Button.Win2k">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MinWidth" Value="75" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontFamily" Value="Tahoma, sans-serif" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Label for field captions -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="FontFamily" Value="Tahoma, sans-serif" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <Border Classes="SearchBorder" Padding="4">
        <DockPanel>
            <!-- Title bar -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Search for Files or Folders"
                       FontSize="11"
                       FontWeight="Bold"
                       Margin="2,0,0,4"
                       VerticalAlignment="Center" />

            <!-- Search criteria section -->
            <Grid DockPanel.Dock="Top"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnDefinitions="Auto,1*"
                  Margin="0,0,0,6">

                <!-- Name contains -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Classes="FieldLabel"
                           Text="All or part of the file name:" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Classes="Sunken"
                         x:Name="NameInput"
                         Text="{Binding NameContains, Mode=TwoWay}"
                         Margin="0,2,0,2" />

                <!-- Containing text -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Classes="FieldLabel"
                           Text="A word or phrase in the file:" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Classes="Sunken"
                         x:Name="ContainingTextInput"
                         Text="{Binding ContainingText, Mode=TwoWay}"
                         Margin="0,2,0,2" />

                <!-- Look in -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Classes="FieldLabel"
                           Text="Look in:" />
                <ComboBox Grid.Row="2" Grid.Column="1"
                          x:Name="LookInCombo"
                          IsEditable="True"
                          MinHeight="22"
                          MaxHeight="22"
                          Margin="0,2,0,2"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center" />
            </Grid>

            <!-- Action buttons row -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="4"
                        Margin="0,0,0,6">
                <Button Classes="Win2k"
                        x:Name="SearchButton"
                        Content="Search Now"
                        Click="OnSearchClick" />
                <Button Classes="Win2k"
                        x:Name="StopButton"
                        Content="Stop"
                        IsEnabled="False"
                        Click="OnStopClick" />
            </StackPanel>

            <!-- Status line -->
            <TextBlock DockPanel.Dock="Top"
                       x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Margin="0,0,0,4"
                       Foreground="#FF000000" />

            <!-- Results area -->
            <Border BorderThickness="1"
                    BorderBrush="#FF808080"
                    Background="#FFFFFFFF">
                <DockPanel>
                    <!-- Results column header -->
                    <Border DockPanel.Dock="Top"
                            BorderThickness="0,0,0,1"
                            BorderBrush="#FF808080"
                            Background="#FFD4D0C8"
                            Height="20">
                        <Grid ColumnDefinitions="1*,80,80,120">
                            <TextBlock Grid.Column="0" Text="Name"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="1" Text="Size"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        <TextBlock Grid.Column="2" Text="Type"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="3" Text="In Folder"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Search results list -->
                    <ListBox x:Name="ResultsList"
                             ItemsSource="{Binding Results}"
                             Background="#FFFFFFFF"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchResultItem">
                                <Grid ColumnDefinitions="1*,80,80,120"
                                      Height="20"
                                      Margin="2,1">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4C4;"
                                                   FontSize="12"
                                                   IsVisible="{Binding IsFile}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="&#x1F4C1;"
                                                   FontSize="12"
                                                   IsVisible="{Binding IsFolder}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12"
                                                   Margin="2,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SizeDisplay}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TypeDescription}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding InFolderDisplay}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
