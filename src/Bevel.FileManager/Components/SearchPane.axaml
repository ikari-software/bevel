<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bevel.FileManager.Components.SearchPane"
             x:Name="Root"
             Focusable="False"
             ClipToBounds="True">

    <UserControl.Styles>
        <!-- Win2000 3D sunken border for the search pane -->
        <Style Selector="Border.SearchBorder">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="Background" Value="#FFD4D0C8" />
        </Style>

        <!-- Win2000 sunken text box look -->
        <Style Selector="TextBox.Sunken">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF808080" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MaxHeight" Value="22" />
        </Style>

        <!-- Win2000 flat button -->
        <Style Selector="Button.Win2k">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MinWidth" Value="75" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontFamily" Value="Tahoma, sans-serif" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Small flat "x" close button -->
        <Style Selector="Button.CloseBtn">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Label for field captions -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="FontFamily" Value="Tahoma, sans-serif" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <Border Classes="SearchBorder" Padding="4">
        <DockPanel>
            <!-- Title bar: caption + close button -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button Classes="CloseBtn"
                        DockPanel.Dock="Right"
                        x:Name="CloseButton"
                        Click="OnCloseClick">
                    <Path Width="8" Height="8"
                          Stroke="#FF000000"
                          StrokeThickness="1"
                          Data="M0,0 L8,8 M8,0 L0,8" />
                </Button>
                <TextBlock Text="Search for Files or Folders"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Search criteria: name only. The pane never runs the search itself — it just
                 raises SearchRequested with the query text; the host window owns SearchService
                 and renders results in the main item view. -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,1*"
                  Margin="0,0,0,6">
                <TextBlock Grid.Column="0"
                           Classes="FieldLabel"
                           Text="All or part of the file name:" />
                <TextBox Grid.Column="1"
                         Classes="Sunken"
                         x:Name="NameInput"
                         Watermark="e.g. *.txt or report"
                         KeyDown="OnNameInputKeyDown" />
            </Grid>

            <!-- Action button -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="4"
                        Margin="0,0,0,6">
                <Button Classes="Win2k"
                        x:Name="SearchButton"
                        Content="Search Now"
                        Click="OnSearchClick" />
            </StackPanel>

            <!-- Status / result-count line -->
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Margin="0,0,0,2"
                       Foreground="#FF000000" />
        </DockPanel>
    </Border>
</UserControl>
