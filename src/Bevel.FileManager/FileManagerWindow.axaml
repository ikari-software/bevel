<components:BevelWindow xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:components="using:Bevel.UI"
         xmlns:fmcomp="using:Bevel.FileManager.Components"
         x:Class="Bevel.FileManager.FileManagerWindow"
         Title="Filer - C:\"
         Width="800" Height="600"
         MinWidth="640" MinHeight="480"
         WindowStartupLocation="CenterScreen">

    <DockPanel>
        <fmcomp:MenuBar DockPanel.Dock="Top" x:Name="MenuBar" />
        <fmcomp:Toolbar DockPanel.Dock="Top" x:Name="Toolbar" />
        <fmcomp:AddressBar DockPanel.Dock="Top" x:Name="AddressBar" />
        <fmcomp:SearchPane DockPanel.Dock="Top" x:Name="SearchPane" IsVisible="False" />
        <fmcomp:TabStrip DockPanel.Dock="Top" x:Name="TabStrip" />
        <fmcomp:StatusBar DockPanel.Dock="Bottom" x:Name="StatusBar" />

        <Grid x:Name="ContentGrid" ColumnDefinitions="200,4,*" Margin="2,0,0,2">
            <!-- Left panel: InfoPane (default) or FilerBar (tree); collapses when info style = Off -->
            <fmcomp:InfoPane x:Name="InfoPane" Grid.Column="0" IsVisible="True"
                             Title="" Description="" Instruction="" ObjectCount="" />
            <fmcomp:FilerBar x:Name="FilerPane" Grid.Column="0" IsVisible="False"
                                Title="Folders">
                <TreeView x:Name="TreeView" BorderThickness="0" Margin="-1,-1,-1,-1" />
            </fmcomp:FilerBar>

            <!-- Sunken splitter -->
            <Border x:Name="LeftSplitter" Grid.Column="1" Width="4" Background="{DynamicResource Bevel.Brush.ButtonFace}"
                    BorderBrush="{DynamicResource Bevel.Brush.ButtonShadow}" BorderThickness="1,0,0,0"
                    Cursor="SizeWestEast" />

            <!-- Right pane: item view -->
            <Border Grid.Column="2" Background="{DynamicResource Bevel.Brush.Window}"
                    BorderBrush="{DynamicResource Bevel.Brush.ButtonShadow}" BorderThickness="1,0,0,0" Padding="1,0,0,0">
                <fmcomp:ItemView x:Name="ItemView" ViewMode="Details" />
            </Border>
        </Grid>
    </DockPanel>
</components:BevelWindow>