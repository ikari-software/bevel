<Project Sdk="Microsoft.NET.Sdk">

  <!-- Default theme. Target state (05 §11): extract semantic resource keys + metrics
       + DPI snapping on top of the vendored Classic.Avalonia source. Classic.Avalonia
       is now vendored in-tree (third_party/classic-avalonia, see NOTICE.md) instead of
       the NuGet package, so the app boots with the Win2000 look. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Vendored in-tree under third_party/classic-avalonia (see NOTICE.md). -->
    <ProjectReference Include="..\..\third_party\classic-avalonia\Classic.Avalonia.Theme\Classic.Avalonia.Theme.csproj" />
    <ProjectReference Include="..\Bevel.UI\Bevel.UI.csproj" />
  </ItemGroup>

  <!-- Vector-only theme: every icon/glyph is code-drawn (Glyphs.cs / ToolbarIcons.cs) and
       recolours via Bevel.Color.* tokens, so the ONLY runtime asset files are the bundled UI
       fonts — Noto Sans (SIL OFL 1.1), the metric-substitute for Win2000's Tahoma (macOS ships
       no Tahoma). The raster exports under Assets/Icons/ are a dev-preview artifact of Glyphs.cs
       (see gallery.html / Bevel.IconPreview); they are regenerable and must NOT ship in the DLL. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/*.ttf" />
  </ItemGroup>

</Project>
