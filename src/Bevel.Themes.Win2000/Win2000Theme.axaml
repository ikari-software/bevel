<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classic="using:Classic.Avalonia.Theme">
    <!--
      Bevel's default Windows 2000 theme: the vendored Classic.Avalonia ClassicTheme with
      Bevel's semantic token layer (Bevel.Color/Brush/Metric/Font.* — see Tokens.axaml,
      bevel-38y) merged on top. Bevel-owned controls bind ONLY the semantic tokens; the
      Classic templates' own keys are an internal detail slated for the ENG-01 audit.
    -->
    <classic:ClassicTheme />

    <!-- Edge rendering (bevel-38y.1 / chrome spec §8): the Win2000 theme owns the mode.
         Smooth by default at all scalings (decision 2026-07-06 — HiDPI-native eased-gradient
         bevels, fixes 150% fuzziness); the whitelisted "Crisp bevels" Display-settings
         override flips this setter when that surface ships. -->
    <Style Selector="classic|ClassicBorderDecorator">
        <Setter Property="EdgeRendering" Value="Smooth" />
    </Style>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Bevel.Themes.Win2000/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
