<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:classic="using:Classic.Avalonia.Theme"
        xmlns:ui="using:Bevel.UI">
    <!--
      Bevel's default Windows 2000 theme: the vendored Classic.Avalonia ClassicTheme with
      Bevel's semantic token layer (Bevel.Color/Brush/Metric/Font.* — see Tokens.axaml,
      bevel-38y) merged on top. Bevel-owned controls bind ONLY the semantic tokens; the
      Classic templates' own keys are an internal detail slated for the ENG-01 audit.
    -->
    <classic:ClassicTheme />

    <!-- Edge rendering (bevel-38y.1 / chrome spec §8): the Win2000 theme owns the mode via
         the Bevel.Edge.Rendering resource (theme.json default: Smooth — HiDPI-native
         eased-gradient bevels). The whitelisted "Crisp bevels" Display-settings toggle
         (bevel-wym) overrides the resource at Application level, which shadows the theme's
         value for DynamicResource lookups and flips every bevel live. -->
    <Style Selector="classic|ClassicBorderDecorator">
        <Setter Property="EdgeRendering" Value="{DynamicResource Bevel.Edge.Rendering}" />
    </Style>
    <Style Selector="ui|BevelBorder">
        <Setter Property="EdgeRendering" Value="{DynamicResource Bevel.Edge.Rendering}" />
    </Style>

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Bevel.Themes.Win2000/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
