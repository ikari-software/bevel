    <!-- ── Metrics (logical px at 1.0 scale) ──────────────────────────────── -->

    <x:Double x:Key="Bevel.Metric.CaptionHeight">18</x:Double>
    <x:Double x:Key="Bevel.Metric.CaptionButtonWidth">16</x:Double>
    <x:Double x:Key="Bevel.Metric.CaptionButtonHeight">14</x:Double>
    <x:Double x:Key="Bevel.Metric.ResizeBorder">4</x:Double>
    <x:Double x:Key="Bevel.Metric.EdgeThickness">2</x:Double>
    <x:Double x:Key="Bevel.Metric.ScrollBarSize">16</x:Double>
    <x:Double x:Key="Bevel.Metric.MenuBarHeight">19</x:Double>
    <x:Double x:Key="Bevel.Metric.MenuItemHeight">17</x:Double>
    <x:Double x:Key="Bevel.Metric.TaskbarHeight">28</x:Double>
    <x:Double x:Key="Bevel.Metric.IconGridCellWidth">75</x:Double>
    <x:Double x:Key="Bevel.Metric.IconGridCellHeight">75</x:Double>
    <x:Double x:Key="Bevel.Metric.FocusRectInset">1</x:Double>
    <CornerRadius x:Key="Bevel.Metric.CornerRadius">0</CornerRadius>
    <Thickness x:Key="Bevel.Metric.ButtonPadding">6,1</Thickness>

    <!-- ── Fonts (families only; faces swap with the asset work) ──────────── -->

    <FontFamily x:Key="Bevel.Font.UI">avares://Bevel.Themes.Win2000/Assets/#Noto Sans</FontFamily>
    <FontFamily x:Key="Bevel.Font.Caption">avares://Bevel.Themes.Win2000/Assets/#Noto Sans</FontFamily>
    <FontFamily x:Key="Bevel.Font.Mono">Menlo,Consolas,monospace</FontFamily>
</ResourceDictionary>
