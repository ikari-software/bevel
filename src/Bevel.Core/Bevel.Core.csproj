<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain / services / settings. MUST NOT reference Avalonia (ARCH-02). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Reactive" />
    <!-- SQLite-backed settings store (WAL, shared across shell processes; bevel-gww.5). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Force the patched native SQLite bundle over the transitive 2.1.11 (NU1903; bevel-711).
         Direct reference makes the Directory.Packages.props pin authoritative. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal trash/copy helpers (LocalTrash) to the Core test project. -->
    <InternalsVisibleTo Include="Bevel.Core.Tests" />
    <!-- The SettingsService(configDir) test seam, so taskbar tests root settings at a temp dir instead
         of clobbering the real ~/.config/bevel/settings.db. -->
    <InternalsVisibleTo Include="Bevel.Taskbar.Tests" />
  </ItemGroup>

</Project>
