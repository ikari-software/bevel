<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain / services / settings. MUST NOT reference Avalonia (ARCH-02). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Reactive" />
    <!-- SQLite-backed settings store (WAL, shared across shell processes; bevel-gww.5). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes internal trash/copy helpers (LocalTrash) to the Core test project. -->
    <InternalsVisibleTo Include="Bevel.Core.Tests" />
  </ItemGroup>

</Project>
