<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bootable Avalonia app + composition root. Per ARCH-03 this is the ONLY
       project allowed to reference concrete PAL implementations. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Native publish strategy (RID-guarded, so a plain/RID-less build is unaffected).
       Opt into NativeAOT with -p:BevelPublishAot=true (bevel-gww.7): a single Mach-O, no JIT, the
       real per-process RSS win. The prerequisites are in place — compiled bindings by default, JSON
       source-gen, DllImport interop (AOT-fine). InvariantGlobalization drops ICU. Absent the opt-in,
       ReadyToRun stays the default: crossgen IL->native for faster cold start and OS-shareable
       read-only code pages across the multi-role processes (the low-risk interim step). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(BevelPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(BevelPublishAot)' != 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bevel.Taskbar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Avalonia.Diagnostics (F12 dev tools) — Debug builds only. -->
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bevel.Core\Bevel.Core.csproj" />
    <ProjectReference Include="..\Bevel.UI\Bevel.UI.csproj" />
    <ProjectReference Include="..\Bevel.Pal.Abstractions\Bevel.Pal.Abstractions.csproj" />
    <ProjectReference Include="..\Bevel.Pal.Fake\Bevel.Pal.Fake.csproj" />
    <ProjectReference Include="..\Bevel.Pal.MacOS\Bevel.Pal.MacOS.csproj" />
    <ProjectReference Include="..\Bevel.ShellCore.Ipc\Bevel.ShellCore.Ipc.csproj" />
    <ProjectReference Include="..\Bevel.Themes.Win2000\Bevel.Themes.Win2000.csproj" />
    <ProjectReference Include="..\Bevel.Themes.Luna\Bevel.Themes.Luna.csproj" />
    <ProjectReference Include="..\Bevel.Desktop\Bevel.Desktop.csproj" />
    <ProjectReference Include="..\Bevel.Taskbar\Bevel.Taskbar.csproj" />
    <ProjectReference Include="..\Bevel.FileManager\Bevel.FileManager.csproj" />
    <ProjectReference Include="..\Bevel.Interop\Bevel.Interop.csproj" />
  </ItemGroup>

</Project>
