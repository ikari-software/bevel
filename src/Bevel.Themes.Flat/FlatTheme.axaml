      <SolidColorBrush x:Key="Blue2001.Brush.StartMenuPlaceIconGeneric" Color="#D9E3F3" />
      <SolidColorBrush x:Key="Blue2001.Brush.StartMenuPinIconFallback" Color="#D9E3F3" />
      <SolidColorBrush x:Key="Blue2001.Brush.StartMenuPlaceIconBorder" Color="#A6AED5" />
