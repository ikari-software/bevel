      <LinearGradientBrush x:Key="Blue2001.Brush.StartMenuFooter" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#ECE9D8"/><GradientStop Offset="1" Color="#DCD7C8"/></LinearGradientBrush>
