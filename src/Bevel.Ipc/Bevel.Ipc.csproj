<Project Sdk="Microsoft.NET.Sdk">

  <!-- gRPC / protobuf helper contract. Generated C# client/server stubs from
       ../../proto land here when the helper handshake track starts. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bevel.Pal.MacOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\*.proto" GrpcServices="Client" Link="Proto\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
