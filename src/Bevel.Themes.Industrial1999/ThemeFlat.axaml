<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:classic="using:Classic.Avalonia.Theme">
    <!-- Legacy Flat resource dictionary retained for compatibility; ThemeService now routes Flat to
         the full watercolor Styles set in Bevel.Themes.Aquarelle/FlatTheme.axaml. -->
    <classic:EdgeRendering x:Key="Bevel.Edge.Rendering">Crisp</classic:EdgeRendering>
    <x:Double x:Key="Bevel.Metric.CaptionHeight">22</x:Double>
    <x:Double x:Key="Bevel.Metric.EdgeThickness">1</x:Double>
    <x:Double x:Key="Bevel.Metric.MenuItemHeight">20</x:Double>
    <CornerRadius x:Key="Bevel.Metric.CornerRadius">3</CornerRadius>
    <Thickness x:Key="Bevel.Metric.ButtonPadding">10,3</Thickness>
</ResourceDictionary>
