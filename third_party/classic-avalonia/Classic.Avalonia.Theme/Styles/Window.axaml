<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:classic="clr-namespace:Classic.Avalonia.Theme"
                    xmlns:utils="clr-namespace:Classic.Avalonia.Theme.Utils"
                    xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
                    x:ClassModifier="internal">
  <ControlTheme x:Key="ClassicWindow"
                TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="Foreground"
            Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}"/>
    <Setter Property="Background"
            Value="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}"/>
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource HighlightForegroundColor}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />
    <Setter Property="SystemDecorations" Value="Full" /> <!-- with Full on Windows 11 we get rounded borders and shadow, which is bad, but unfortunately with None, dragging and resizing doesn't work -->
    <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />

    <Style Selector="^.__classic_theme_is_mac">
      <Setter Property="SystemDecorations" Value="None" /> <!-- on a mac None decorations work fine and we still can drag and resize the window -->
    </Style>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Bevel: NO forced EdgeMode=Aliased. Everything is vector + antialiased ("designed in 2026" /
             never-disable-AA): AA is a no-op on Win2000's axis-aligned 1px bevels and smooths Luna's rounded
             corners. (Font AA is the FontAliasingKey resource; per-skin bevel crispness is BevelBorder.) -->
        <Panel RenderOptions.BitmapInterpolationMode="None"
               utils:FontUtils.FontAliasing="{DynamicResource {x:Static common:SystemParameters.FontAliasingKey}}">
          <Border Name="PART_TransparencyFallback"
                  IsHitTestVisible="False"
                  CornerRadius="{DynamicResource Bevel.Metric.CornerRadius}"
                  Margin="2" />
          <!-- Backdrop fill. Rounded top under Luna (CornerRadius token 8,8,0,0) so it does NOT paint the
               triangles outside the caption's rounded corners — with a transparent Luna window surface those
               corners then show the desktop through. Win2000 radius is 0, so this stays a square fill. -->
          <Border Background="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}"
                  IsHitTestVisible="False"
                  CornerRadius="{DynamicResource Bevel.Metric.CornerRadius}"
                  Margin="2" />

          <Border Margin="{TemplateBinding OffScreenMargin}">
            <!-- The caption docks full-width at the very top so its rounded top corners ARE the window's
                 top corners (it's the top of the frame, not a bar floating inside it). The window "frame"
                 is then a border on the sides+bottom only, wrapping the content BELOW the caption — driven
                 by Bevel.Metric.WindowContentBorder (Luna: 3px blue L/R/B, 0 top; Win2000: 0, since its Bd
                 3D bevel is the frame). -->
            <DockPanel LastChildFill="True">

              <!-- Bevel.Metric.CaptionMargin frames the caption. Win2000 = 4,4,4,0: 2px 3D bevel + 2px face
                   above/beside the caption (matching the sizing frame on the sides), 0 bottom so it meets the
                   content — the 1px caption→client separator comes from WindowContentInset.top=1. Luna = 0:
                   the caption stays full-bleed so its rounded top corners are the window's corners (a967ec8). -->
              <utils:AutoAttachTitleBar DockPanel.Dock="Top" Margin="{DynamicResource Bevel.Metric.CaptionMargin}" />

              <Border BorderBrush="{DynamicResource Bevel.Brush.WindowFrame}"
                      BorderThickness="{DynamicResource Bevel.Metric.WindowContentBorder}"
                      Background="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}">
                <DockPanel Name="RootLayout"
                           Margin="{DynamicResource Bevel.Metric.WindowContentInset}"
                           ClipToBounds="True">
                  <VisualLayerManager>
                    <VisualLayerManager.ChromeOverlayLayer>
                      <TitleBar />
                    </VisualLayerManager.ChromeOverlayLayer>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ClipToBounds="True"/>
                  </VisualLayerManager>
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>

          <classic:ClassicBorderDecorator Name="Bd"
                                          BorderStyle="AltRaised"
                                          IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ classic|ClassicBorderDecorator#Bd">
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="^[WindowState=Maximized]">
      <Style Selector="^ /template/ DockPanel#RootLayout">
        <Setter Property="Margin" Value="{Binding $parent[Window].OffScreenMargin}"/>
      </Style>
      <Style Selector="^ /template/ classic|ClassicBorderDecorator#Bd">
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Window}"
                TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
    <Setter Property="Background" Value="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.ControlTextBrushKey}}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Bevel: NO forced EdgeMode=Aliased. Everything is vector + antialiased ("designed in 2026" /
             never-disable-AA): AA is a no-op on Win2000's axis-aligned 1px bevels and smooths Luna's rounded
             corners. (Font AA is the FontAliasingKey resource; per-skin bevel crispness is BevelBorder.) -->
        <Panel RenderOptions.BitmapInterpolationMode="None"
               utils:FontUtils.FontAliasing="{DynamicResource {x:Static common:SystemParameters.FontAliasingKey}}">
          <Border Name="PART_TransparencyFallback"
                  IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}"
                  IsHitTestVisible="False" />
          <Panel Margin="{TemplateBinding WindowDecorationMargin}"
                 Background="Transparent" />
          <VisualLayerManager>
            <VisualLayerManager.ChromeOverlayLayer>
              <TitleBar />
            </VisualLayerManager.ChromeOverlayLayer>
            <ContentPresenter Name="PART_ContentPresenter"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type classic:ClassicWindow}" TargetType="classic:ClassicWindow" BasedOn="{StaticResource ClassicWindow}">
  </ControlTheme>
</ResourceDictionary>
