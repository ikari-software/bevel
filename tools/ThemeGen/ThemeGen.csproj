<Project Sdk="Microsoft.NET.Sdk">

  <!-- Theme token code generator (MET-01 / bevel-51t): theme.json → Tokens.axaml +
       ThemeTokens.cs. Same drift-checked codegen pattern as native/helper-macos proto
       generation — run it, commit the output, CI fails if the two ever diverge. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
