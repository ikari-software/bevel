<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarized Developer ID build (M5, signing step: bevel-nsk).
  Not sandboxed (a shell replacement needs broad filesystem + window access). The JIT / unsigned-
  memory entitlements cover the CoreCLR JIT for the ReadyToRun build; a pure NativeAOT build
  (BevelPublishAot=true) can drop them. apple-events lets Bevel SEND events (Tier 3, post-v1);
  RECEIVING events (tier 1) needs no entitlement.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
