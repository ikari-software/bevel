<Project Sdk="Microsoft.NET.Sdk">

  <!-- Faceless harness to prove the inbound-Apple-Events interop (M4-C native, bevel-376) in
       isolation before porting into Bevel.App: register an NSAppleEventManager handler via a
       runtime-created ObjC class, receive real `tell application` events from osascript, log what
       arrives + the extracted direct object. NOT shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AssemblyName>aeprobe</AssemblyName>
  </PropertyGroup>

</Project>
