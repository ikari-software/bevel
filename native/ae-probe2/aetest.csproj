<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal Avalonia app that wires the REAL AppleEventInbound (Bevel.Pal.MacOS) to a logging
       handler, to confirm Avalonia's [NSApp run] loop dispatches our custom AE verbs (the one open
       question after the ae-probe spike proved delivery). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>aetest</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bevel.Pal.MacOS\Bevel.Pal.MacOS.csproj" />
  </ItemGroup>

</Project>
