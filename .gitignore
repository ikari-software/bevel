# --- Tooling / session state ---
.omc/
.mimocode/
.claude/settings.local.json

# --- macOS ---
.DS_Store

# --- .NET / Avalonia (for when code lands) ---
bin/
obj/
[Bb]uild/
# build/RepoPaths.cs is a hand-written SOURCE (bevel-eabc), not build output: re-include just that file.
!/build/
/build/*
!/build/RepoPaths.cs
*.user
*.suo
.vs/
artifacts/
publish/

# --- Rider / VS Code (keep shared config, drop local) ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# --- Native helper build output ---
native/**/.build/
native/**/DerivedData/
*.xcuserstate

# --- Swift test rigs build output (tests/rigs/**) ---
tests/rigs/**/.build/
tests/rigs/**/DerivedData/

# Note: .beads/ is intentionally NOT ignored — beads is a git-backed tracker.

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.claude/worktrees/

# Agent scratch: per-tool session state, never part of the project. Sibling dirs from other
# tools (.qwen/, .playwright-mcp/) are deleted rather than ignored — add them here if they return.
.context/

# Local clean-room reference stash (public Win2000 screenshots for measurement only —
# Microsoft-copyrighted images; never committed/shipped; see docs/reference/win2000/)
refs/

# Raster icon exports are dev-preview artifacts of the vector source (Glyphs.cs, regenerable
# via Bevel.IconPreview → gallery.html). The shell is vector-always: never commit/ship raster.
src/Bevel.Themes.Win2000/Assets/Icons/**/*.png

# Packaged app-bundle output (packaging/macos/build-app.sh assembles it fresh).
dist/

# AE probe build output (native/ae-probe/run.sh assembles it fresh).
native/ae-probe/out/

native/ae-probe2/out/

# BenchmarkDotNet output (perf harness, bevel-zhmr)
BenchmarkDotNet.Artifacts/


# Built release artifacts staged for bevel.run (not committed — deployed from a local machine)
site/downloads/
