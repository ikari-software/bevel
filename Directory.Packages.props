<Project>

  <!-- Central Package Management (CPM). Versions live here; csproj files use
       <PackageReference> with no Version attribute. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>11.3.18</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <!-- Required by the vendored Classic.CommonControls.Avalonia (third_party/). -->
    <PackageVersion Include="Avalonia.Skia" Version="11.3.18" />

    <!-- Composition root / DI / hosting -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />

    <!-- gRPC / Protobuf -->
    <PackageVersion Include="Grpc.Tools" Version="2.70.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.67.0" />

    <!-- Reactive / Observable -->
    <PackageVersion Include="System.Reactive" Version="6.0.1" />

    <!-- Settings store: raw ADO.NET SQLite provider (no EF Core — this is a lean shell).
         Backs SettingsService with a WAL DB shared across shell processes (bevel-gww.5). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Pin the native SQLite bundle forward past Microsoft.Data.Sqlite 10.0.9's transitive
         2.1.11 (NU1903 / GHSA-2m69-gcr7-jv3q). 3.0.x is the first patched line — there is no
         2.1.12 — and bundles lib.e_sqlite3 3.53.3. Direct-referenced in Bevel.Core so the
         override wins over the transitive resolve (bevel-711). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
