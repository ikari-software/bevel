# direnv: make a plain `dotnet build` / `dotnet test` in this repo use the SDK global.json pins, not
# whatever `dotnet` is first on PATH (e.g. a Homebrew dotnet with a newer major and no matching SDK).
# Same resolver the build scripts source. Run `direnv allow` once after cloning or when this file changes.
ROOT="$PWD"
watch_file global.json tools/sh/pinned-dotnet.sh
source tools/sh/pinned-dotnet.sh
